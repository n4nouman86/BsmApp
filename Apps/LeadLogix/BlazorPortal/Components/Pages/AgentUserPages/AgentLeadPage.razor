@page "/AgentLead"
@attribute [Authorize(Roles = "Agent")]
<PageTitle>Agent Leads</PageTitle>

@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject AuthenticationStateProvider authProvider
@inject UserManager<ApplicationUser> userManager
@inject NotificationService notify
@inject NavigationManager navManager
@inject IHttpContextAccessor httpContext
@inject IConfiguration config
@inject IJSRuntime JS

<PageHeading HeadingText="Agent Leads" />

<RadzenCard>
    <RadzenStack Orientation="Orientation.Horizontal" Gap="1" JustifyContent="JustifyContent.SpaceBetween">
        <div>
            <RadzenButton Text="Refresh Leads" ButtonStyle="ButtonStyle.Secondary" Click="() => RefreshTodayTransfer(true)" />

            <RadzenToggleButton @bind-Value="isAgentActive"
                                Text="@(isAgentActive ? "Agent is Online" : "Agent is Offline")"
                                ButtonStyle="ButtonStyle.Danger"
                                ToggleButtonStyle="ButtonStyle.Success"
                                Change="AgentStatusChange" />
        </div>

        @if (Agent?.PauseTimer > 0)
        {
            <div>
                <RadzenLabel class="text-danger">Pause time left @Agent?.PauseTimer.ToString("N1") minutes</RadzenLabel>
                <RadzenButton ButtonType="ButtonType.Button" ButtonStyle="ButtonStyle.Primary" Text="Cancel" Click="CancelPause" />
            </div>
        }
        else
        {
            <div>
                <RadzenLabel>Pause Till (minutes)</RadzenLabel>
                <RadzenNumeric @bind-Value="PauseTill" />
                <RadzenButton ButtonType="ButtonType.Button" Text="Update" Click="UpdatePause" />
            </div>
        }
    </RadzenStack>
</RadzenCard>

<br />

<RadzenStack Orientation="Orientation.Horizontal">
    <RadzenCard>
        <RadzenFieldset Text="Search">
            <EditForm Model="Input" OnValidSubmit="SearchLeads">
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.End">
                    <RadzenStack Gap="0">
                        <RadzenLabel>Date From</RadzenLabel>
                        <RadzenDatePicker @bind-Value="Input.FromDate" DateFormat="dd-MMM-yyyy" />
                    </RadzenStack>

                    <RadzenStack Gap="0">
                        <RadzenLabel>Date To</RadzenLabel>
                        <RadzenDatePicker @bind-Value="Input.ToDate" DateFormat="dd-MMM-yyyy" />
                    </RadzenStack>

                    <RadzenStack Gap="0">
                        <RadzenLabel>Disposition (optional)</RadzenLabel>
                        <RadzenDropDown @bind-Value="Input.StatusId" Data="DispositionStatuses" ValueProperty="Id" TextProperty="Name" AllowClear />
                    </RadzenStack>

                    <RadzenStack Gap="0">
                        <RadzenLabel>Billable</RadzenLabel>
                        <RadzenCheckBox @bind-Value="Input.Billable" />
                    </RadzenStack>

                    <RadzenStack>
                        <RadzenButton ButtonType="ButtonType.Submit" Text="Search" />
                    </RadzenStack>
                </RadzenStack>
            </EditForm>
        </RadzenFieldset>
    </RadzenCard>

    <RadzenCard>
        <RadzenFieldset Text="Search">
            <EditForm Model="Input" OnValidSubmit="SearchByName">
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.End">
                    <RadzenStack Gap="0">
                        <RadzenLabel>Full Name</RadzenLabel>
                        <RadzenTextBox @bind-Value="Input.FullName" />
                        <ValidationMessage For="() => Input.FullName" class="text-danger" />
                    </RadzenStack>

                    <RadzenStack>
                        <RadzenButton ButtonType="ButtonType.Submit" Text="Search" />
                    </RadzenStack>
                </RadzenStack>
            </EditForm>
        </RadzenFieldset>
    </RadzenCard>

    <RadzenCard>
        <RadzenFieldset Text="Search">
            <EditForm Model="Input" OnValidSubmit="SearchByPhone">
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.End">
                    <RadzenStack Gap="0">
                        <RadzenLabel>Phone Number</RadzenLabel>
                        <RadzenTextBox @bind-Value="Input.PhoneNumber" />
                        <ValidationMessage For="() => Input.PhoneNumber" class="text-danger" />
                    </RadzenStack>

                    <RadzenStack>
                        <RadzenButton ButtonType="ButtonType.Submit" Text="Search" />
                    </RadzenStack>
                </RadzenStack>
            </EditForm>
        </RadzenFieldset>
    </RadzenCard>
</RadzenStack>

<br />

<RadzenCard>
    @if (Leads is null)
    {
        <em>Loading...</em>
    }
    else
    {
        <RadzenDataGrid Data="Leads" AllowPaging ShowPagingSummary>
            <HeaderTemplate>
                <RadzenStack Orientation="Orientation.Horizontal">
                    <div>
                        <RadzenButton Icon="grid_on" Disabled="@(!Leads.Any())" ButtonStyle="ButtonStyle.Danger" Text="Export CSV" Click="ExportCSV" />
                    </div>
                </RadzenStack>
            </HeaderTemplate>

            <Columns>
                <RadzenDataGridColumn Title="Transfer On" Width="180px">
                    <Template Context="lead">
                        @lead.TransferOn.ToLacalDateTimeOffset(AppUser!.TimeZoneInfoId).DateTime.ToDateTimeString()
                    </Template>
                    <FooterTemplate>
                        <strong>Total Leads: @Leads.Count()</strong>
                    </FooterTemplate>
                </RadzenDataGridColumn>

                <RadzenDataGridColumn Property="FullName" Title="Full Name">
                    <FooterTemplate>
                        <strong>Billables: @Leads.Count(x => x.IsBillable)</strong>
                    </FooterTemplate>
                </RadzenDataGridColumn>
                
                <RadzenDataGridColumn Property="PhoneNumber" Title="Phone Number" />
                <RadzenDataGridColumn Property="State" Title="State" TextAlign="TextAlign.Center" />

                <RadzenDataGridColumn Title="Disposition On" Width="180px">
                    <Template Context="lead">
                        @lead.DispositionOn?.ToLacalDateTimeOffset(AppUser!.TimeZoneInfoId).DateTime.ToDateTimeString()
                    </Template>
                </RadzenDataGridColumn>

                <RadzenDataGridColumn Property="DispositionTypeName" Title="Disposition Type" TextAlign="TextAlign.Center" />
                <RadzenDataGridColumn Property="DispositionStatusName" Title="Disposition Status" TextAlign="TextAlign.Center" />

                <RadzenDataGridColumn Title="Is Billable" TextAlign="TextAlign.Center">
                    <Template Context="lead">
                        <BooleanBadge BoolValue="lead.IsBillable" GreenText="yes" DangerText="no" />
                    </Template>
                </RadzenDataGridColumn>

                <RadzenDataGridColumn Title="Action" TextAlign="TextAlign.Center">
                    <Template Context="lead">
                        <RadzenLink Path="@String.Concat("AgentLeadOpen/", lead.Id)">
                            <RadzenButton Icon="edit" Size="ButtonSize.Small" ButtonStyle="@ButtonStyle.Secondary" />
                        </RadzenLink>

                        <RadzenLink Path="@String.Concat("LeadStatus/", lead.Id)">
                            <RadzenButton Icon="highlight_keyboard_focus" Size="ButtonSize.Small" ButtonStyle="@ButtonStyle.Secondary" />
                        </RadzenLink>
                    </Template>
                </RadzenDataGridColumn>
            </Columns>
        </RadzenDataGrid>
    }
</RadzenCard>