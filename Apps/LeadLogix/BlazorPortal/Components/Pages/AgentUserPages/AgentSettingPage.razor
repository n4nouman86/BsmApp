@page "/AgentSetting"
@attribute [Authorize(Roles = "Agent")]
<PageTitle>Agent Settings</PageTitle>

@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject NotificationService notify
@inject AuthenticationStateProvider authProvider
@inject UserManager<ApplicationUser> userManager

<PageHeading HeadingText="Agent Settings" />



<RadzenCard>

    @if (Input is null)
    {
        <em>Loading...</em>
    }
    else
    {
        <EditForm Model="Input" OnValidSubmit="UpdateAgent">
            <DataAnnotationsValidator />
            <ValidationSummary class="text-danger" />

            <div class="row">

                <div class="col-md-6">
                    <RadzenFieldset Text="Transfer Info">
                        <div class="mb-3">
                            <RadzenLabel>Transfer No DID (optional)</RadzenLabel>
                            <RadzenTextBox @bind-Value="Input.TransferNoDid" class="w-100" />
                            <ValidationMessage For="() => Input.TransferNoDid" class="text-danger" />
                        </div>

                        <div class="mb-3">
                            <RadzenLabel>Daily Cap</RadzenLabel>
                            <RadzenNumeric @bind-Value="Input.DailyCap" class="w-100" />
                            <ValidationMessage For="() => Input.DailyCap" class="text-danger" />
                        </div>

                    </RadzenFieldset>
                </div>

                <div class="col-md-12">
                    <RadzenFieldset Text="Agent Shcedule">
                        <div class="row">

                            <div class="col-md-6">
                                <div class="mb-3">
                                    <RadzenLabel>Mon Schedule From (optional)</RadzenLabel>
                                    <RadzenDatePicker @bind-Value="Input.MonScheduleFrom" class="w-100" ShowTime ShowSeconds="false" TimeOnly HourFormat="12" DateFormat="hh:mm tt" />
                                    <ValidationMessage For="() => Input.MonScheduleFrom" class="text-danger" />
                                </div>

                                <div class="mb-3">
                                    <RadzenLabel>Tue Schedule From (optional)</RadzenLabel>
                                    <RadzenDatePicker @bind-Value="Input.TueScheduleFrom" class="w-100" ShowTime ShowSeconds="false" TimeOnly HourFormat="12" DateFormat="hh:mm tt" />
                                    <ValidationMessage For="() => Input.TueScheduleFrom" class="text-danger" />
                                </div>

                                <div class="mb-3">
                                    <RadzenLabel>Wed Schedule From (optional)</RadzenLabel>
                                    <RadzenDatePicker @bind-Value="Input.WedScheduleFrom" class="w-100" ShowTime ShowSeconds="false" TimeOnly HourFormat="12" DateFormat="hh:mm tt" />
                                    <ValidationMessage For="() => Input.WedScheduleFrom" class="text-danger" />
                                </div>

                                <div class="mb-3">
                                    <RadzenLabel>Thu Schedule From (optional)</RadzenLabel>
                                    <RadzenDatePicker @bind-Value="Input.ThuScheduleFrom" class="w-100" ShowTime ShowSeconds="false" TimeOnly HourFormat="12" DateFormat="hh:mm tt" />
                                    <ValidationMessage For="() => Input.ThuScheduleFrom" class="text-danger" />
                                </div>

                                <div class="mb-3">
                                    <RadzenLabel>Fri Schedule From (optional)</RadzenLabel>
                                    <RadzenDatePicker @bind-Value="Input.FriScheduleFrom" class="w-100" ShowTime ShowSeconds="false" TimeOnly HourFormat="12" DateFormat="hh:mm tt" />
                                    <ValidationMessage For="() => Input.FriScheduleFrom" class="text-danger" />
                                </div>

                                <div class="mb-3">
                                    <RadzenLabel>Sat Schedule From (optional)</RadzenLabel>
                                    <RadzenDatePicker @bind-Value="Input.SatScheduleFrom" class="w-100" ShowTime ShowSeconds="false" TimeOnly HourFormat="12" DateFormat="hh:mm tt" AllowClear />
                                    <ValidationMessage For="() => Input.SatScheduleFrom" class="text-danger" />
                                </div>

                                <div class="mb-3">
                                    <RadzenLabel>Sun Schedule From (optional)</RadzenLabel>
                                    <RadzenDatePicker @bind-Value="Input.SunScheduleFrom" class="w-100" ShowTime ShowSeconds="false" TimeOnly HourFormat="12" DateFormat="hh:mm tt" AllowClear />
                                    <ValidationMessage For="() => Input.SunScheduleFrom" class="text-danger" />
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="mb-3">
                                    <RadzenLabel>Mon Schedule To (optional)</RadzenLabel>
                                    <RadzenDatePicker @bind-Value="Input.MonScheduleTo" class="w-100" ShowTime ShowSeconds="false" TimeOnly HourFormat="12" DateFormat="hh:mm tt" />
                                    <ValidationMessage For="() => Input.MonScheduleTo" class="text-danger" />
                                </div>

                                <div class="mb-3">
                                    <RadzenLabel>Tue Schedule To (optional)</RadzenLabel>
                                    <RadzenDatePicker @bind-Value="Input.TueScheduleTo" class="w-100" ShowTime ShowSeconds="false" TimeOnly HourFormat="12" DateFormat="hh:mm tt" />
                                    <ValidationMessage For="() => Input.TueScheduleTo" class="text-danger" />
                                </div>

                                <div class="mb-3">
                                    <RadzenLabel>Wed Schedule To (optional)</RadzenLabel>
                                    <RadzenDatePicker @bind-Value="Input.WedScheduleTo" class="w-100" ShowTime ShowSeconds="false" TimeOnly HourFormat="12" DateFormat="hh:mm tt" />
                                    <ValidationMessage For="() => Input.WedScheduleTo" class="text-danger" />
                                </div>

                                <div class="mb-3">
                                    <RadzenLabel>Thu Schedule To (optional)</RadzenLabel>
                                    <RadzenDatePicker @bind-Value="Input.ThuScheduleTo" class="w-100" ShowTime ShowSeconds="false" TimeOnly HourFormat="12" DateFormat="hh:mm tt" />
                                    <ValidationMessage For="() => Input.ThuScheduleTo" class="text-danger" />
                                </div>

                                <div class="mb-3">
                                    <RadzenLabel>Fri Schedule To (optional)</RadzenLabel>
                                    <RadzenDatePicker @bind-Value="Input.FriScheduleTo" class="w-100" ShowTime ShowSeconds="false" TimeOnly HourFormat="12" DateFormat="hh:mm tt" />
                                    <ValidationMessage For="() => Input.FriScheduleTo" class="text-danger" />
                                </div>

                                <div class="mb-3">
                                    <RadzenLabel>Sat Schedule To (optional)</RadzenLabel>
                                    <RadzenDatePicker @bind-Value="Input.SatScheduleTo" class="w-100" ShowTime ShowSeconds="false" TimeOnly HourFormat="12" DateFormat="hh:mm tt" AllowClear />
                                    <ValidationMessage For="() => Input.SatScheduleTo" class="text-danger" />
                                </div>

                                <div class="mb-3">
                                    <RadzenLabel>Sun Schedule To (optional)</RadzenLabel>
                                    <RadzenDatePicker @bind-Value="Input.SunScheduleTo" class="w-100" ShowTime ShowSeconds="false" TimeOnly HourFormat="12" DateFormat="hh:mm tt" AllowClear />
                                    <ValidationMessage For="() => Input.SunScheduleTo" class="text-danger" />
                                </div>
                            </div>

                        </div>
                    </RadzenFieldset>
                </div>

            </div>


            <div class="mt-3">
                <RadzenButton ButtonType="ButtonType.Submit">Update</RadzenButton>
            </div>
        </EditForm>
    }

</RadzenCard>
