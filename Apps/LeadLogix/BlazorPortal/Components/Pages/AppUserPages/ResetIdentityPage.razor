@page "/ResetIdentity"
@attribute [Authorize(Roles = "Super Admin")]
<PageTitle>Reset Identity</PageTitle>

@inject UserManager<ApplicationUser> userManager
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject AuthenticationStateProvider authenticationStateProvider
@inject NotificationService notify
@inject DialogService dialogService

<PageHeading HeadingText="Reset Identity" />

<RadzenCard>
    @if (ApplicationUsers is null)
    {
        <em>Loading...</em>
    }
    else
    {
        <RadzenStack>
            <RadzenText>Total Users Found: <b>@ApplicationUsers.Count()</b></RadzenText>

            <RadzenProgressBar Min="0"
                               Max="ApplicationUsers.Count()"
                               Value="ProgressValue"
                               ShowValue
                               Unit="@($" out of {ApplicationUsers.Count()} reset")" />

            <div>
                <RadzenButton ButtonStyle="ButtonStyle.Danger" Click="ResetIdentityAync">
                    Reset Identity
                </RadzenButton>
            </div>
        </RadzenStack>
    }
</RadzenCard>


