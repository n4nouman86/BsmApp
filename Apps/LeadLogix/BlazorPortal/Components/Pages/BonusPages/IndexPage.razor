@page "/BonusIndex"
@attribute [Authorize(Roles = "Super Admin")]
<PageTitle>Employee Bonus</PageTitle>

@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject IJSRuntime jsRuntime

<PageHeading HeadingText="Employee Bonus" />

<RadzenCard>
    <EditForm Model="Input" OnValidSubmit="LoadBonus">
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.End">
            <RadzenStack Gap="0">
                <RadzenLabel Text="Select From" />
                <RadzenDatePicker @bind-Value="Input.DateFrom" DateFormat="MMM, dd yyyy" ShowTime="false" Change="SaveLocalStorage" />
            </RadzenStack>

            <RadzenStack Gap="0">
                <RadzenLabel Text="Select To" />
                <RadzenDatePicker @bind-Value="Input.DateTo" DateFormat="MMM, dd yyyy" ShowTime="false" Change="SaveLocalStorage" />
            </RadzenStack>

            <RadzenStack Gap="0">
                <RadzenLabel Text="Days" />
                <RadzenNumeric @bind-Value="Input.Days" TValue="int" Change="SaveLocalStorage" />
            </RadzenStack>
            
            <RadzenStack Gap="0">
                <RadzenLabel Text="Payment Month" />
                <RadzenDatePicker @bind-Value="Input.PaymentMonth" DateFormat="MMM yyyy" ShowTime="false" Change="SaveLocalStorage" />
            </RadzenStack>

            <RadzenButton ButtonType="ButtonType.Submit" Text="Load" />
        </RadzenStack>
    </EditForm>
</RadzenCard>

<br />

<RadzenCard>
    @if (Bonuses is null)
    {
        <em>Loading...</em>
    }
    else
    {
        @foreach (var emp in Bonuses.Select(b => b.EmployeeName).Distinct())
        {
            var empBonuses = Bonuses.Where(b => b.EmployeeName == emp).ToList();
            var totalCost = empBonuses.Sum(b => b.InvoiceTotalCost);

            <RadzenDataGrid Data="@empBonuses" Responsive
                            AllowColumnReorder
                            AllowColumnResize
                            EmptyText="No bonuses to display">

                <Columns>
                    <RadzenDataGridColumn Property="EmployeeName" Title="Employee Name" />
                    <RadzenDataGridColumn Property="AgentName" Title="Agent Name" />
                    <RadzenDataGridColumn Property="AgentOnboardOn" Title="Agent Onboard On" FormatString="{0:dd MMM yyyy}" TextAlign="TextAlign.Center" />
                    <RadzenDataGridColumn Property="InvoiceServiceFrom" Title="Invoice Service From" FormatString="{0:dd MMM yyyy}" TextAlign="TextAlign.Center" />
                    <RadzenDataGridColumn Property="InvoiceTotalCost" Title="Invoice Total Cost" FormatString="{0:C0}" TextAlign="TextAlign.Center">
                        <FooterTemplate>
                            <b>@totalCost.ToString("C0")</b>
                        </FooterTemplate>
                    </RadzenDataGridColumn>
                </Columns>
            </RadzenDataGrid>
            <br />
        }
    }
</RadzenCard>
