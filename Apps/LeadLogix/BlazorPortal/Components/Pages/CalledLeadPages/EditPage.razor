@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject DialogService DialogService

@if (Input is null)
{
    <em>Loading...</em>
}
else
{
    <EditForm Model="Input" OnValidSubmit="Save">
        <DataAnnotationsValidator />

        <RadzenRow>
            <RadzenColumn SizeMD="4">
                <RadzenFieldset Text="Lead Info">
                    <RadzenStack>
                        <RadzenStack Gap="0">
                            <RadzenLabel Text="Called On" />
                            <RadzenDatePicker @bind-Value="Input.CalledOn" ShowTime DateFormat="MMM, dd yyyy hh:mm tt" />
                        </RadzenStack>

                        <RadzenStack Gap="0">
                            <RadzenLabel Text="Phone Number" />
                            <RadzenTextBox @bind-Value="Input.PhoneNumber" />
                            <ValidationMessage For="() => Input.PhoneNumber" class="rz-message rz-messages-error " />
                        </RadzenStack>

                        <RadzenStack Gap="0">
                            <RadzenLabel Text="Full Name" />
                            <RadzenTextBox @bind-Value="Input.FullName" />
                            <ValidationMessage For="() => Input.FullName" class="rz-message rz-messages-error " />
                        </RadzenStack>

                        <RadzenStack Gap="0">
                            <RadzenLabel Text="Date Of Birth" />
                            <RadzenTextBox @bind-Value="Input.DateOfBirth" />
                            <ValidationMessage For="() => Input.DateOfBirth" class="rz-message rz-messages-error " />
                        </RadzenStack>

                        <RadzenStack Gap="0">
                            <RadzenLabel Text="Address" />
                            <RadzenTextArea @bind-Value="Input.Address" Rows="3" />
                            <ValidationMessage For="() => Input.Address" class="rz-message rz-messages-error " />
                        </RadzenStack>

                        <RadzenStack Gap="0">
                            <RadzenLabel Text="Select State" />
                            <RadzenDropDown 
                                @bind-Value="Input.StateId" 
                                Data="States" 
                                TextProperty="Text" 
                                ValueProperty="Id" 
                                AllowFiltering 
                                FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive" />
                        </RadzenStack>

                        <RadzenStack Gap="0">
                            <RadzenLabel>Spouse</RadzenLabel>
                            <RadzenDropDown Name="Spouse" @bind-Value="Input.Spouse" Data="@(new List<string> { "Yes", "No" })" />
                            <RadzenDataAnnotationValidator Component="Spouse" />
                            <RadzenNumericRangeValidator Min="1" Text="Select spouse." />
                        </RadzenStack>

                        <RadzenStack Gap="0">
                            <RadzenLabel Text="Spouse Name" />
                            <RadzenTextBox @bind-Value="Input.SpouseName" />
                        </RadzenStack>

                        <RadzenStack Gap="0">
                            <RadzenLabel Text="Spouse DOB" />
                            <RadzenTextBox @bind-Value="Input.SpouseDob" />
                        </RadzenStack>
                    </RadzenStack>
                </RadzenFieldset>
            </RadzenColumn>

            <RadzenColumn SizeMD="4">
                <RadzenFieldset Text="Auto & Home Info">
                    <RadzenStack>
                        <RadzenStack Gap="0">
                            <RadzenLabel Text="Current Auto Carrier" />
                            <RadzenTextBox @bind-Value="Input.CurrentAutoCarrier" />
                            <ValidationMessage For="() => Input.CurrentAutoCarrier" class="rz-message rz-messages-error " />
                        </RadzenStack>

                        <RadzenStack Gap="0">
                            <RadzenLabel>Any Lapses</RadzenLabel>
                            <RadzenDropDown Name="AnyLapses" @bind-Value="Input.AnyLapses" Data="@(new List<string> { "Yes", "No" })" />
                            <RadzenDataAnnotationValidator Component="AnyLapses" />
                        </RadzenStack>
                        
                        <RadzenStack Gap="0">
                            <RadzenLabel Text="Make And Model" />
                            <RadzenTextArea @bind-Value="Input.MakeAndModel" Rows="5" />
                            <ValidationMessage For="() => Input.MakeAndModel" class="rz-message rz-messages-error " />
                        </RadzenStack>

                        <RadzenStack Gap="0">
                            <RadzenLabel>Accidents</RadzenLabel>
                            <RadzenDropDown Name="Accidents" @bind-Value="Input.Accidents" Data="@(new List<string> { "No", "1", "2" })" />
                            <RadzenDataAnnotationValidator Component="Accidents" />
                        </RadzenStack>

                        <RadzenStack Gap="0">
                            <RadzenLabel>Tickets</RadzenLabel>
                            <RadzenDropDown Name="Tickets" @bind-Value="Input.Tickets" Data="@(new List<string> { "No", "1", "2" })" />
                            <RadzenDataAnnotationValidator Component="Tickets" />
                        </RadzenStack>
                    </RadzenStack>
                </RadzenFieldset>
            </RadzenColumn>

            <RadzenColumn SizeMD="4">
                <RadzenFieldset Text="Home Info">
                    <RadzenStack>
                        <RadzenStack Gap="0">
                            <RadzenLabel>Home Owner</RadzenLabel>
                            <RadzenDropDown Name="HomeOwner" @bind-Value="Input.HomeOwner" Data="@(new List<string> { "Yes", "No" })" />
                            <RadzenDataAnnotationValidator Component="HomeOwner" />
                        </RadzenStack>

                        <RadzenStack Gap="0">
                            <RadzenLabel Text="Home Type" />
                            <RadzenTextBox @bind-Value="Input.HomeType" />
                        </RadzenStack>

                        <RadzenStack Gap="0">
                            <RadzenLabel Text="Have Home Claims" />
                            <RadzenTextBox @bind-Value="Input.HaveHomeClaims" />
                        </RadzenStack>

                        <RadzenStack Gap="0">
                            <RadzenLabel Text="Current Home Carrier" />
                            <RadzenTextBox @bind-Value="Input.CurrentHomeCarrier" />
                        </RadzenStack>

                        <RadzenStack Gap="0">
                            <RadzenLabel>Any Claim In Past 3 Years</RadzenLabel>
                            <RadzenDropDown Name="AnyClaimInPastThreeYears" @bind-Value="Input.AnyClaimInPastThreeYears" Data="@(new List<string> { "Yes", "No" })" />
                            <RadzenRequiredValidator Component="AnyClaimInPastThreeYears" Text="Any claim in past three years is required." />
                            <RadzenDataAnnotationValidator Component="AnyClaimInPastThreeYears" />
                        </RadzenStack>

                        <RadzenStack Gap="0">
                            <RadzenLabel Text="Status" />
                            <RadzenTextBox @bind-Value="Input.Status" />
                            <ValidationMessage For="() => Input.Status" class="rz-message rz-messages-error " />
                        </RadzenStack>
                    </RadzenStack>
                </RadzenFieldset>
            </RadzenColumn>

            <RadzenStack Orientation="Orientation.Horizontal" Gap="10">
                <RadzenButton ButtonType="ButtonType.Submit" Text="Save" ButtonStyle="ButtonStyle.Primary" />
                <RadzenButton ButtonType="ButtonType.Button" Text="Cancel" ButtonStyle="ButtonStyle.Light" Click="Cancel" />
            </RadzenStack>
        </RadzenRow>
    </EditForm>
}
