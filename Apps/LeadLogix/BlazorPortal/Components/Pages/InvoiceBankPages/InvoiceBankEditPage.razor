@page "/InvoiceBankEdit/{Id:int}"
@attribute [Authorize(Roles = "Super Admin")]
<PageTitle>Edit Invoice Bank</PageTitle>

@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject NavigationManager navManager

<PageHeading HeadingText="Edit Invoice Bank" />

<div class="row">
    <div class="col-md-6">
        <RadzenCard>

            @if (Input is null)
            {
                <em>Loading...</em>
            }
            else
            {
                <EditForm Model="Input" OnValidSubmit="CreateBank">
                    <div class="mb-3">
                        <RadzenLabel>Select Bank</RadzenLabel>
                        <RadzenDropDown @bind-Value="Input.InvoiceBankTypeId" Data="BankTypes" ValueProperty="Id" TextProperty="Name" class="w-100" />
                        <ValidationMessage For="() => Input.InvoiceBankTypeId" class="text-danger" />
                    </div>

                    @if (Input.InvoiceBankTypeId == 1)
                    {
                        <div class="mb-3">
                            <RadzenLabel>Bank Name</RadzenLabel>
                            <RadzenTextBox @bind-Value="Input.BankName" class="w-100" />
                            <ValidationMessage For="() => Input.BankName" class="text-danger" />
                        </div>

                        <div class="mb-3">
                            <RadzenLabel>Bank Address</RadzenLabel>
                            <RadzenTextBox @bind-Value="Input.BankAddress" class="w-100" />
                            <ValidationMessage For="() => Input.BankAddress" class="text-danger" />
                        </div>

                        <div class="mb-3">
                            <RadzenLabel>Routing</RadzenLabel>
                            <RadzenTextBox @bind-Value="Input.Routing" class="w-100" />
                            <ValidationMessage For="() => Input.Routing" class="text-danger" />
                        </div>

                        <div class="mb-3">
                            <RadzenLabel>Account Number</RadzenLabel>
                            <RadzenTextBox @bind-Value="Input.AccountNumber" class="w-100" />
                            <ValidationMessage For="() => Input.AccountNumber" class="text-danger" />
                        </div>

                        <div class="mb-3">
                            <RadzenLabel>Account Type</RadzenLabel>
                            <RadzenTextBox @bind-Value="Input.AccountType" class="w-100" />
                            <ValidationMessage For="() => Input.AccountType" class="text-danger" />
                        </div>

                        <div class="mb-3">
                            <RadzenLabel>Beneficiary Name</RadzenLabel>
                            <RadzenTextBox @bind-Value="Input.BeneficiaryName" class="w-100" />
                            <ValidationMessage For="() => Input.BeneficiaryName" class="text-danger" />
                        </div>

                        <div class="mb-3">
                            <RadzenLabel>Currency</RadzenLabel>
                            <RadzenTextBox @bind-Value="Input.Currency" class="w-100" />
                            <ValidationMessage For="() => Input.Currency" class="text-danger" />
                        </div>

                    }


                    @if (Input.InvoiceBankTypeId == 2)
                    {
                        <div class="mb-3">
                            <RadzenLabel>Bank Name</RadzenLabel>
                            <RadzenTextBox @bind-Value="Input.BankName" class="w-100" />
                            <ValidationMessage For="() => Input.BankName" class="text-danger" />
                        </div>

                        <div class="mb-3">
                            <RadzenLabel>Branch Address</RadzenLabel>
                            <RadzenTextBox @bind-Value="Input.BranchAddress" class="w-100" />
                            <ValidationMessage For="() => Input.BranchAddress" class="text-danger" />
                        </div>

                        <div class="mb-3">
                            <RadzenLabel>Account Title</RadzenLabel>
                            <RadzenTextBox @bind-Value="Input.AccountTitle" class="w-100" />
                            <ValidationMessage For="() => Input.AccountTitle" class="text-danger" />
                        </div>

                        <div class="mb-3">
                            <RadzenLabel>Iban or Account Number</RadzenLabel>
                            <RadzenTextBox @bind-Value="Input.IbanorAccountNumber" class="w-100" />
                            <ValidationMessage For="() => Input.IbanorAccountNumber" class="text-danger" />
                        </div>

                        <div class="mb-3">
                            <RadzenLabel>Swift Code</RadzenLabel>
                            <RadzenTextBox @bind-Value="Input.SwiftCode" class="w-100" />
                            <ValidationMessage For="() => Input.SwiftCode" class="text-danger" />
                        </div>

                        <div class="mb-3">
                            <RadzenLabel>Currency</RadzenLabel>
                            <RadzenTextBox @bind-Value="Input.Currency" class="w-100" />
                            <ValidationMessage For="() => Input.Currency" class="text-danger" />
                        </div>
                    }


                    @if (Input.InvoiceBankTypeId == 3)
                    {
                        <div class="mb-3">
                            <RadzenLabel>Contract Name</RadzenLabel>
                            <RadzenTextBox @bind-Value="Input.ContractName" class="w-100" />
                            <ValidationMessage For="() => Input.ContractName" class="text-danger" />
                        </div>
                    }


                    @if (Input.InvoiceBankTypeId == 4)
                    {
                        <div class="mb-3">
                            <RadzenLabel>Beneficiary Name</RadzenLabel>
                            <RadzenTextBox @bind-Value="Input.BeneficiaryName" class="w-100" />
                            <ValidationMessage For="() => Input.BeneficiaryName" class="text-danger" />
                        </div>

                        <div class="mb-3">
                            <RadzenLabel>Email</RadzenLabel>
                            <RadzenTextBox @bind-Value="Input.Email" class="w-100" />
                            <ValidationMessage For="() => Input.Email" class="text-danger" />
                        </div>

                        <div class="mb-3">
                            <RadzenLabel>Currency</RadzenLabel>
                            <RadzenTextBox @bind-Value="Input.Currency" class="w-100" />
                            <ValidationMessage For="() => Input.Currency" class="text-danger" />
                        </div>
                    }


                    @if (Input.InvoiceBankTypeId == 5)
                    {
                        <div class="mb-3">
                            <RadzenLabel>Contact Name</RadzenLabel>
                            <RadzenTextBox @bind-Value="Input.ContactName" class="w-100" />
                            <ValidationMessage For="() => Input.ContactName" class="text-danger" />
                        </div>

                        <div class="mb-3">
                            <RadzenLabel>Payment Link</RadzenLabel>
                            <RadzenTextBox @bind-Value="Input.PaymentLink" class="w-100" />
                            <ValidationMessage For="() => Input.PaymentLink" class="text-danger" />
                        </div>

                        <div class="mb-3">
                            <RadzenLabel>Currency</RadzenLabel>
                            <RadzenTextBox @bind-Value="Input.Currency" class="w-100" />
                            <ValidationMessage For="() => Input.Currency" class="text-danger" />
                        </div>
                    }


                    @if (Input.InvoiceBankTypeId == 6)
                    {
                        <div class="mb-3">
                            <RadzenLabel>Bank Name</RadzenLabel>
                            <RadzenTextBox @bind-Value="Input.BankName" class="w-100" />
                            <ValidationMessage For="() => Input.BankName" class="text-danger" />
                        </div>

                        <div class="mb-3">
                            <RadzenLabel>Bank Address</RadzenLabel>
                            <RadzenTextBox @bind-Value="Input.BankAddress" class="w-100" />
                            <ValidationMessage For="() => Input.BankAddress" class="text-danger" />
                        </div>

                        <div class="mb-3">
                            <RadzenLabel>Bank Code</RadzenLabel>
                            <RadzenTextBox @bind-Value="Input.BankCode" class="w-100" />
                            <ValidationMessage For="() => Input.BankCode" class="text-danger" />
                        </div>

                        <div class="mb-3">
                            <RadzenLabel>Branch Code</RadzenLabel>
                            <RadzenTextBox @bind-Value="Input.BranchCode" class="w-100" />
                            <ValidationMessage For="() => Input.BranchCode" class="text-danger" />
                        </div>

                        <div class="mb-3">
                            <RadzenLabel>Swift Code</RadzenLabel>
                            <RadzenTextBox @bind-Value="Input.SwiftCode" class="w-100" />
                            <ValidationMessage For="() => Input.SwiftCode" class="text-danger" />
                        </div>

                        <div class="mb-3">
                            <RadzenLabel>Iban or Account Number</RadzenLabel>
                            <RadzenTextBox @bind-Value="Input.IbanorAccountNumber" class="w-100" />
                            <ValidationMessage For="() => Input.IbanorAccountNumber" class="text-danger" />
                        </div>

                        <div class="mb-3">
                            <RadzenLabel>Beneficiary Name</RadzenLabel>
                            <RadzenTextBox @bind-Value="Input.BeneficiaryName" class="w-100" />
                            <ValidationMessage For="() => Input.BeneficiaryName" class="text-danger" />
                        </div>

                        <div class="mb-3">
                            <RadzenLabel>Currency</RadzenLabel>
                            <RadzenTextBox @bind-Value="Input.Currency" class="w-100" />
                            <ValidationMessage For="() => Input.Currency" class="text-danger" />
                        </div>
                    }

                    <div class="mb-3">
                        <RadzenLabel>Guide (optional) (<b>Use ; for line break</b>)</RadzenLabel>
                        <RadzenTextArea @bind-Value="Input.Guidlines" class="w-100" />
                        <ValidationMessage For="() => Input.Guidlines" class="text-danger" />
                    </div>

                    <div>
                        <RadzenButton ButtonType="ButtonType.Submit" Text="Update" />
                    </div>
                </EditForm>
            }

        </RadzenCard>
    </div>
</div>
