@page "/InvoiceBankIndex"
@attribute [Authorize(Roles = "Super Admin")]
<PageTitle>Invoice Bank</PageTitle>

@inject IDbContextFactory<ApplicationDbContext> DbFactory


<PageHeading HeadingText="Invoice Bank" />

@if (Banks is null)
{
    <em>Loading...</em>
}
else
{
    <RadzenText Text="Foreign Account" TextStyle="TextStyle.Subtitle1" />

    <RadzenCard>
        <RadzenDataGrid Data="@Banks.Where(x => x.InvoiceBankTypeId == 1)" AllowPaging PageSize="10">

            <Columns>
                <RadzenDataGridColumn Property="BankName" Title="Bank Name" />
                <RadzenDataGridColumn Property="BankAddress" Title="Bank Address" />
                <RadzenDataGridColumn Property="Routing" Title="Routing" />
                <RadzenDataGridColumn Property="AccountNumber" Title="Account Number" />
                <RadzenDataGridColumn Property="AccountType" Title="Account Type" />
                <RadzenDataGridColumn Property="Currency" Title="Currency" />
                <RadzenDataGridColumn Property="BeneficiaryName" Title="Beneficiary Name" />

                <RadzenDataGridColumn Title="Action" TextAlign="TextAlign.Center">
                    <Template Context="bank">
                        <RadzenLink Path="@String.Concat("InvoiceBankEdit/", bank.Id)">
                            <RadzenButton Icon="edit" Size="ButtonSize.Small" ButtonStyle="@ButtonStyle.Secondary" />
                        </RadzenLink>
                    </Template>
                </RadzenDataGridColumn>
            </Columns>
        </RadzenDataGrid>
    </RadzenCard>
    
    <br />





    <RadzenText Text="Local Bank Account" TextStyle="TextStyle.Subtitle1" />

    <RadzenCard>
        <RadzenDataGrid Data="@Banks.Where(x => x.InvoiceBankTypeId == 2)" AllowPaging PageSize="10">

            <Columns>
                <RadzenDataGridColumn Property="BankName" Title="Bank Name" />
                <RadzenDataGridColumn Property="BranchAddress" Title="Branch Address" />
                <RadzenDataGridColumn Property="IbanorAccountNumber" Title="Iban or Account Number" />
                <RadzenDataGridColumn Property="AccountTitle" Title="Account Title" />
                <RadzenDataGridColumn Property="SwiftCode" Title="Swift Code" />
                <RadzenDataGridColumn Property="Currency" Title="Currency" />

                <RadzenDataGridColumn Title="Action" TextAlign="TextAlign.Center">
                    <Template Context="bank">
                        <RadzenLink Path="@String.Concat("InvoiceBankEdit/", bank.Id)">
                            <RadzenButton Icon="edit" Size="ButtonSize.Small" ButtonStyle="@ButtonStyle.Secondary" />
                        </RadzenLink>
                    </Template>
                </RadzenDataGridColumn>
            </Columns>
        </RadzenDataGrid>
    </RadzenCard>

    <br />






    <RadzenText Text="Upwork" TextStyle="TextStyle.Subtitle1" />

    <RadzenCard>
        <RadzenDataGrid Data="@Banks.Where(x => x.InvoiceBankTypeId == 3)" AllowPaging PageSize="10">

            <Columns>
                <RadzenDataGridColumn Property="ContractName" Title="Contract Name" />

                <RadzenDataGridColumn Title="Action" TextAlign="TextAlign.Center">
                    <Template Context="bank">
                        <RadzenLink Path="@String.Concat("InvoiceBankEdit/", bank.Id)">
                            <RadzenButton Icon="edit" Size="ButtonSize.Small" ButtonStyle="@ButtonStyle.Secondary" />
                        </RadzenLink>
                    </Template>
                </RadzenDataGridColumn>
            </Columns>
        </RadzenDataGrid>
    </RadzenCard>


    <br />






    <RadzenText Text="Payoneer" TextStyle="TextStyle.Subtitle1" />

    <RadzenCard>
        <RadzenDataGrid Data="@Banks.Where(x => x.InvoiceBankTypeId == 4)" AllowPaging PageSize="10">

            <Columns>
                <RadzenDataGridColumn Property="BeneficiaryName" Title="Beneficiary Name" />
                <RadzenDataGridColumn Property="Email" Title="Email" />
                <RadzenDataGridColumn Property="Currency" Title="Currency" />

                <RadzenDataGridColumn Title="Action" TextAlign="TextAlign.Center">
                    <Template Context="bank">
                        <RadzenLink Path="@String.Concat("InvoiceBankEdit/", bank.Id)">
                            <RadzenButton Icon="edit" Size="ButtonSize.Small" ButtonStyle="@ButtonStyle.Secondary" />
                        </RadzenLink>
                    </Template>
                </RadzenDataGridColumn>
            </Columns>
        </RadzenDataGrid>
    </RadzenCard>

    <br />






    <RadzenText Text="Credit Card (Upwork Direct Payment Link for Credit Card)" TextStyle="TextStyle.Subtitle1" />

    <RadzenCard>
        <RadzenDataGrid Data="@Banks.Where(x => x.InvoiceBankTypeId == 5)" AllowPaging PageSize="10">

            <Columns>
                <RadzenDataGridColumn Property="ContactName" Title="Contact Name" />
                <RadzenDataGridColumn Property="PaymentLink" Title="Payment Link" />
                <RadzenDataGridColumn Property="Currency" Title="Currency" />

                <RadzenDataGridColumn Title="Action" TextAlign="TextAlign.Center">
                    <Template Context="bank">
                        <RadzenLink Path="@String.Concat("InvoiceBankEdit/", bank.Id)">
                            <RadzenButton Icon="edit" Size="ButtonSize.Small" ButtonStyle="@ButtonStyle.Secondary" />
                        </RadzenLink>
                    </Template>
                </RadzenDataGridColumn>
            </Columns>
        </RadzenDataGrid>
    </RadzenCard>

    <br />






    <RadzenText Text="Foreign Account Wire Transfer" TextStyle="TextStyle.Subtitle1" />

    <RadzenCard>
        <RadzenDataGrid Data="@Banks.Where(x => x.InvoiceBankTypeId == 6)" AllowPaging PageSize="10">

            <Columns>
                <RadzenDataGridColumn Property="BankName" Title="Bank Name" />
                <RadzenDataGridColumn Property="BankAddress" Title="Bank Address" />
                <RadzenDataGridColumn Property="BankCode" Title="Bank Code" />
                <RadzenDataGridColumn Property="BranchCode" Title="Branch Code" />
                <RadzenDataGridColumn Property="SwiftCode" Title="Swift Code" />
                <RadzenDataGridColumn Property="IbanorAccountNumber" Title="IBAN Or Account Number" />
                <RadzenDataGridColumn Property="BeneficiaryName" Title="Beneficiary Name" />
                <RadzenDataGridColumn Property="Currency" Title="Currency" />

                <RadzenDataGridColumn Title="Action" TextAlign="TextAlign.Center">
                    <Template Context="bank">
                        <RadzenLink Path="@String.Concat("InvoiceBankEdit/", bank.Id)">
                            <RadzenButton Icon="edit" Size="ButtonSize.Small" ButtonStyle="@ButtonStyle.Secondary" />
                        </RadzenLink>
                    </Template>
                </RadzenDataGridColumn>
            </Columns>
        </RadzenDataGrid>
    </RadzenCard>







    
    
}

