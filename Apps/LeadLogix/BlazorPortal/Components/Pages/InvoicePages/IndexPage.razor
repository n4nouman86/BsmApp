@page "/InvoiceIndex"
@attribute [Authorize(Roles = "Super Admin")]
<PageTitle>Invoices</PageTitle>

@inject IDbContextFactory<ApplicationDbContext> contextFactory
@inject DialogService dialogService
@inject IJSRuntime jsRuntime

<PageHeading HeadingText="Invoices" />

<RadzenStack AlignItems="AlignItems.Start">
    <RadzenButton Icon="add" Text="Add New Invoice" ButtonStyle="ButtonStyle.Primary" Click="OpenCreate" />
</RadzenStack>

<br />

<RadzenCard>
    <RadzenRow AlignItems="AlignItems.End">
        <RadzenColumn>
            <RadzenCard Variant="Variant.Outlined" class="py-1 ps-3 pe-5">
                <RadzenText TextStyle="TextStyle.Overline">Unpaid Invoices</RadzenText>
                <RadzenText TextStyle="TextStyle.H6"><strong>@UnpaidInvoices.ToString("N0")</strong></RadzenText>
            </RadzenCard>
        </RadzenColumn>

        <RadzenColumn>
            <RadzenCard Variant="Variant.Outlined" class="py-1 ps-3 pe-5">
                <RadzenText TextStyle="TextStyle.Overline">Unpaid Amount</RadzenText>
                <RadzenText TextStyle="TextStyle.H5"><strong>@UnpaidAmount.ToString("C0")</strong></RadzenText>
            </RadzenCard>
        </RadzenColumn>

        <RadzenColumn>
            <RadzenCard Variant="Variant.Outlined" class="py-1 ps-3 pe-5">
                <RadzenText TextStyle="TextStyle.Overline">Last Week Billables</RadzenText>
                <RadzenText TextStyle="TextStyle.H5"><strong>@lastWeekBillables.ToString("N0")</strong></RadzenText>
            </RadzenCard>
        </RadzenColumn>

        <RadzenColumn>
            <RadzenCard Variant="Variant.Outlined" class="py-1 ps-3 pe-5">
                <RadzenText TextStyle="TextStyle.Overline">This Week Billables</RadzenText>
                <RadzenText TextStyle="TextStyle.H5"><strong>@thisWeekBillables.ToString("N0")</strong></RadzenText>
            </RadzenCard>
        </RadzenColumn>
    </RadzenRow>
</RadzenCard>

<br />

<RadzenRow>
    <RadzenColumn Size="9">
        <RadzenCard>
            <RadzenFieldset Text="Search">
                <EditForm Model="Input" OnValidSubmit="SearchInvoice">
                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.End">
                        <RadzenStack Gap="0">
                            <RadzenLabel>Invoice Date From</RadzenLabel>
                            <RadzenDatePicker @bind-Value="Input.DateFrom" DateFormat="dd MMM yyyy" class="w-100" />
                        </RadzenStack>
                        <RadzenStack Gap="0">
                            <RadzenLabel>Invoice Date To</RadzenLabel>
                            <RadzenDatePicker @bind-Value="Input.DateTo" DateFormat="dd MMM yyyy" class="w-100" />
                        </RadzenStack>
                        <RadzenStack Gap="0">
                            <RadzenLabel>Agent (optional)</RadzenLabel>
                            <RadzenDropDown @bind-Value="Input.AgentId" Data="Agents" ValueProperty="Id" TextProperty="Text" class="w-100" AllowClear AllowFiltering FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive" />
                        </RadzenStack>
                        <RadzenStack Gap="0">
                            <RadzenLabel>Status (optional)</RadzenLabel>
                            <RadzenDropDown @bind-Value="Input.PaidInvoice" Data="@(new List<string>{ "Paid", "Not Paid" })" class="w-100" AllowClear AllowFiltering />
                        </RadzenStack>
                        <RadzenStack>
                            <RadzenButton ButtonType="ButtonType.Submit" Text="Search" />
                        </RadzenStack>
                    </RadzenStack>
                </EditForm>
            </RadzenFieldset>
        </RadzenCard>
    </RadzenColumn>

    <RadzenColumn Size="3">
        <RadzenCard>
            <RadzenFieldset Text="Search">
                <EditForm Model="Input" OnValidSubmit="SearchInvoiceByNo">
                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.End">
                        <RadzenStack Gap="0">
                            <RadzenLabel>Invoice No</RadzenLabel>
                            <RadzenNumeric @bind-Value="Input.InvoiceNo" class="w-100" />
                        </RadzenStack>
                        <RadzenStack>
                            <RadzenButton ButtonType="ButtonType.Submit" Text="Search" />
                        </RadzenStack>
                    </RadzenStack>
                </EditForm>
            </RadzenFieldset>
        </RadzenCard>
    </RadzenColumn>
</RadzenRow>

<br />

<RadzenCard>
    @if (Invoices is null)
    {
        <em>Loading...</em>
    }
    else
    {

        <div>
            <RadzenButton ButtonStyle="ButtonStyle.Warning" Click="GetUnpaidInvoices">Unpaid Invoices</RadzenButton>
            <RadzenButton ButtonStyle="ButtonStyle.Secondary" Click="GetLateInvoices">Late Invoices</RadzenButton>
            <RadzenButton Text="Csv Export" Click="CsvExport" />
        </div>

        <br />

        <RadzenCard Variant="Variant.Outlined">
            <RadzenRow>
                <RadzenColumn>
                    <RadzenText TextStyle="TextStyle.Overline">Invoices</RadzenText>
                    <RadzenText TextStyle="TextStyle.H6"><strong>@Invoices.Count().ToString("N0")</strong></RadzenText>
                </RadzenColumn>
                <RadzenColumn>
                    <RadzenText TextStyle="TextStyle.Overline">Billables</RadzenText>
                    <RadzenText TextStyle="TextStyle.H6"><strong>@Invoices.Sum(x => x.BillableLeads).ToString("N0")</strong></RadzenText>
                </RadzenColumn>
                <RadzenColumn>
                    <RadzenText TextStyle="TextStyle.Overline">Discount</RadzenText>
                    <RadzenText TextStyle="TextStyle.H6"><strong>@Invoices.Sum(x => x.DiscountAmount)?.ToString("C0")</strong></RadzenText>
                </RadzenColumn>
                <RadzenColumn>
                    <RadzenText TextStyle="TextStyle.Overline">Total</RadzenText>
                    <RadzenText TextStyle="TextStyle.H6"><strong>@Invoices.Sum(x => x.TotalCost).ToString("C0")</strong></RadzenText>
                </RadzenColumn>
                <RadzenColumn>
                    <RadzenText TextStyle="TextStyle.Overline">Receive</RadzenText>
                    <RadzenText TextStyle="TextStyle.H6" class="text-success"><strong>@Invoices.Sum(x => x.ReceiveAmount)?.ToString("C0")</strong></RadzenText>
                </RadzenColumn>
                <RadzenColumn>
                    <RadzenText TextStyle="TextStyle.Overline">Difference</RadzenText>
                    <RadzenText TextStyle="TextStyle.H6" class="text-danger"><strong>@Invoices.Sum(x => x.DiffAmount)?.ToString("C0")</strong></RadzenText>
                </RadzenColumn>
            </RadzenRow>
        </RadzenCard>

        <br />

        <RadzenDataGrid Data="Invoices" Responsive AllowColumnReorder AllowColumnResize EmptyText="No invoices to display">
            <Columns>
                <RadzenDataGridColumn Property="InvoiceNo" Title="Invoice No" Width="100px" Frozen>
                    <Template Context="invoice">
                        @string.Concat("AC", invoice.InvoiceNo)
                    </Template>
                </RadzenDataGridColumn>

                <RadzenDataGridColumn Property="CreateOn" Title="Create Date" FormatString="{0:dd MMM yyyy}" TextAlign="TextAlign.Center" Width="120px" Frozen />

                <RadzenDataGridColumn Property="FullName" Title="Agent Name" Width="180px" Frozen />

                <RadzenDataGridColumn Title="Due Date" TextAlign="TextAlign.Center" Width="120px">
                    <Template Context="invoice">@invoice.DueDate.ToDateString()</Template>
                </RadzenDataGridColumn>

                <RadzenDataGridColumn Title="Service" TextAlign="TextAlign.Center" Width="150px">
                    <Template Context="invoice">
                        @invoice.ServiceFrom.ToString("dd MMM") - @invoice.ServiceTo.ToString("dd MMM")
                    </Template>
                </RadzenDataGridColumn>

                <RadzenDataGridColumn Property="BillableLeads" Title="Billable" FormatString="{0:N0}" TextAlign="TextAlign.Center" Width="120px" />
                <RadzenDataGridColumn Property="CostPerLead" Title="Cost Per" FormatString="{0:C0}" TextAlign="TextAlign.Center" Width="120px" />
                <RadzenDataGridColumn Property="DiscountAmount" Title="Dis Amt" FormatString="{0:C0}" TextAlign="TextAlign.Center" Width="120px" />
                <RadzenDataGridColumn Property="TotalCost" Title="Tot Amt" FormatString="{0:C0}" TextAlign="TextAlign.Center" Width="120px" />
                <RadzenDataGridColumn Property="ReceiveAmount" Title="Rec Amt" FormatString="{0:C0}" TextAlign="TextAlign.Center" Width="120px" />
                <RadzenDataGridColumn Property="DiffAmount" Title="Diff Amt" FormatString="{0:C0}" TextAlign="TextAlign.Center" Width="120px" />

                <RadzenDataGridColumn Title="Paid On" TextAlign="TextAlign.Center" Width="120px">
                    <Template Context="invoice">
                        @if (invoice.PaidOn.HasValue)
                        {
                            <RadzenBadge BadgeStyle="BadgeStyle.Success">@invoice.PaidOn?.ToDateString()</RadzenBadge>
                        }
                        else
                        {
                            <RadzenBadge BadgeStyle="BadgeStyle.Danger">Unpaid</RadzenBadge>
                        }
                    </Template>
                </RadzenDataGridColumn>

                <RadzenDataGridColumn Title="Action" TextAlign="TextAlign.Center" Width="170px">
                    <Template Context="invoice">
                        <RadzenButton Icon="edit" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Primary"
                            Click="@(() => OpenEdit(invoice.Id))" title="Edit" />

                        <RadzenLink Path="@String.Concat("InvoiceView/", invoice.Id)" Target="blank">
                            <RadzenButton Icon="print" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Info" title="Print Invoice" />
                        </RadzenLink>

                        <RadzenLink Path="@String.Concat("InvoiceViewElite/", invoice.Id)" Target="blank">
                            <RadzenButton Icon="print" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Info" title="Print Elite Invoice" />
                        </RadzenLink>

                        <RadzenButton Icon="disabled_by_default" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Danger"
                            Click="@(() => SaveDefault(invoice))" title="Mark as default invoice" />
                    </Template>
                </RadzenDataGridColumn>
            </Columns>
        </RadzenDataGrid>
    }
</RadzenCard>
