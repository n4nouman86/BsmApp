@page "/LeadStatus/{id:guid}"
@attribute [Authorize(Roles = "Super Admin,QA,Agent")]
<PageTitle>Lead Status</PageTitle>

@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject NotificationService notify
@inject AuthenticationStateProvider authProvider
@inject UserManager<ApplicationUser> userManager
@inject NavigationManager navManager
@inject IConfiguration config

<PageHeading HeadingText="Lead Status" />

@if (Lead is null)
{
    <em>Loading...</em>
}
else
{
    <RadzenRow>
        <RadzenColumn>
            <RadzenCard>
                <RadzenFieldset Text="Lead Info">
                    <RadzenStack>
                        <RadzenStack Gap="0">
                            <RadzenText TextStyle="TextStyle.Overline">Transfer On</RadzenText>
                            <RadzenText TextStyle="TextStyle.Subtitle2"><b>@Lead.TransferOn.ToLacalDateTimeOffset(AppUser!.TimeZoneInfoId).DateTime.ToDateTimeString()</b></RadzenText>
                        </RadzenStack>

                        <RadzenStack Gap="0">
                            <RadzenText TextStyle="TextStyle.Overline">Phone Number</RadzenText>
                            <RadzenText TextStyle="TextStyle.Subtitle2"><b>@Lead.PhoneNumber</b></RadzenText>
                        </RadzenStack>

                        <RadzenStack Gap="0">
                            <RadzenText TextStyle="TextStyle.Overline">Full Name</RadzenText>
                            <RadzenText TextStyle="TextStyle.Subtitle2"><b>@Lead.FullName</b></RadzenText>
                        </RadzenStack>

                        <RadzenStack Gap="0">
                            <RadzenText TextStyle="TextStyle.Overline">Date Of Birth</RadzenText>
                            <RadzenText TextStyle="TextStyle.Subtitle2"><b>@Lead.DateOfBirth</b></RadzenText>
                        </RadzenStack>

                        <RadzenStack Gap="0">
                            <RadzenText TextStyle="TextStyle.Overline">Address</RadzenText>
                            <RadzenText TextStyle="TextStyle.Subtitle2"><b>@Lead.Address</b></RadzenText>
                        </RadzenStack>

                        <RadzenStack Gap="0">
                            <RadzenText TextStyle="TextStyle.Overline">State</RadzenText>
                            <RadzenText TextStyle="TextStyle.Subtitle2"><b>@Lead.State</b></RadzenText>
                        </RadzenStack>

                        <RadzenStack Gap="0">
                            <RadzenText TextStyle="TextStyle.Overline">Spouse</RadzenText>
                            <RadzenText TextStyle="TextStyle.Subtitle2"><b>@Lead.Spouse</b></RadzenText>
                        </RadzenStack>

                        <RadzenStack Gap="0">
                            <RadzenText TextStyle="TextStyle.Overline">Spouse Name</RadzenText>
                            <RadzenText TextStyle="TextStyle.Subtitle2"><b>@Lead.SpouseName</b></RadzenText>
                        </RadzenStack>

                        <RadzenStack Gap="0">
                            <RadzenText TextStyle="TextStyle.Overline">Spouse DOB</RadzenText>
                            <RadzenText TextStyle="TextStyle.Subtitle2"><b>@Lead.SpouseDob</b></RadzenText>
                        </RadzenStack>
                    </RadzenStack>
                </RadzenFieldset>
            </RadzenCard>
        </RadzenColumn>

        <RadzenColumn>
            <RadzenCard>
                <RadzenFieldset Text="Auto & Home Info">
                    <RadzenStack>
                        <RadzenStack Gap="0">
                            <RadzenText TextStyle="TextStyle.Overline">Current Auto Carrier</RadzenText>
                            <RadzenText TextStyle="TextStyle.Subtitle2"><b>@Lead.CurrentAutoCarrier</b></RadzenText>
                        </RadzenStack>

                        <RadzenStack Gap="0">
                            <RadzenText TextStyle="TextStyle.Overline">Any Lapses</RadzenText>
                            <RadzenText TextStyle="TextStyle.Subtitle2"><b>@Lead.AnyLapses</b></RadzenText>
                        </RadzenStack>

                        <RadzenStack Gap="0">
                            <RadzenText TextStyle="TextStyle.Overline">Make And Model</RadzenText>
                            <RadzenText TextStyle="TextStyle.Subtitle2" Style="white-space:pre-wrap"><b>@Lead.MakeAndModel</b></RadzenText>
                        </RadzenStack>

                        <RadzenStack Gap="0">
                            <RadzenText TextStyle="TextStyle.Overline">Accidents</RadzenText>
                            <RadzenText TextStyle="TextStyle.Subtitle2"><b>@Lead.Accidents</b></RadzenText>
                        </RadzenStack>

                        <RadzenStack Gap="0">
                            <RadzenText TextStyle="TextStyle.Overline">Tickets</RadzenText>
                            <RadzenText TextStyle="TextStyle.Subtitle2"><b>@Lead.Tickets</b></RadzenText>
                        </RadzenStack>

                        <RadzenStack Gap="0">
                            <RadzenText TextStyle="TextStyle.Overline">Home Owner</RadzenText>
                            <RadzenText TextStyle="TextStyle.Subtitle2"><b>@Lead.HomeOwner</b></RadzenText>
                        </RadzenStack>

                        <RadzenStack Gap="0">
                            <RadzenText TextStyle="TextStyle.Overline">Home Type</RadzenText>
                            <RadzenText TextStyle="TextStyle.Subtitle2"><b>@Lead.HomeType</b></RadzenText>
                        </RadzenStack>

                        <RadzenStack Gap="0">
                            <RadzenText TextStyle="TextStyle.Overline">Current Home Carrier</RadzenText>
                            <RadzenText TextStyle="TextStyle.Subtitle2"><b>@Lead.CurrentHomeCarrier</b></RadzenText>
                        </RadzenStack>

                        <RadzenStack Gap="0">
                            <RadzenText TextStyle="TextStyle.Overline">Any Claim In Past 3 Years</RadzenText>
                            <RadzenText TextStyle="TextStyle.Subtitle2"><b>@Lead.AnyClaimInPastThreeYears</b></RadzenText>
                        </RadzenStack>
                    </RadzenStack>
                </RadzenFieldset>
            </RadzenCard>
        </RadzenColumn>

        <RadzenColumn>
            <RadzenCard>
                <RadzenFieldset Text="Other Lead Info">
                    <RadzenStack>
                        @if (!string.IsNullOrWhiteSpace(Lead.CustomLabel1))
                        {
                            <RadzenStack Gap="0">
                                <RadzenText TextStyle="TextStyle.Overline">@Lead.CustomLabel1</RadzenText>
                                <RadzenText TextStyle="TextStyle.Subtitle2"><b>@Lead.Custom1</b></RadzenText>
                            </RadzenStack>
                        }

                        @if (!string.IsNullOrWhiteSpace(Lead.CustomLabel2))
                        {
                            <RadzenStack Gap="0">
                                <RadzenText TextStyle="TextStyle.Overline">@Lead.CustomLabel2</RadzenText>
                                <RadzenText TextStyle="TextStyle.Subtitle2"><b>@Lead.Custom2</b></RadzenText>
                            </RadzenStack>
                        }

                        @if (!string.IsNullOrWhiteSpace(Lead.CustomLabel3))
                        {
                            <RadzenStack Gap="0">
                                <RadzenText TextStyle="TextStyle.Overline">@Lead.CustomLabel3</RadzenText>
                                <RadzenText TextStyle="TextStyle.Subtitle2"><b>@Lead.Custom3</b></RadzenText>
                            </RadzenStack>
                        }

                        @if (!string.IsNullOrWhiteSpace(Lead.CustomLabel4))
                        {
                            <RadzenStack Gap="0">
                                <RadzenText TextStyle="TextStyle.Overline">@Lead.CustomLabel4</RadzenText>
                                <RadzenText TextStyle="TextStyle.Subtitle2"><b>@Lead.Custom4</b></RadzenText>
                            </RadzenStack>
                        }

                        @if (!string.IsNullOrWhiteSpace(Lead.CustomLabel5))
                        {
                            <RadzenStack Gap="0">
                                <RadzenText TextStyle="TextStyle.Overline">@Lead.CustomLabel5</RadzenText>
                                <RadzenText TextStyle="TextStyle.Subtitle2"><b>@Lead.Custom5</b></RadzenText>
                            </RadzenStack>
                        }
                        @if (!string.IsNullOrWhiteSpace(Lead.CustomLabel6))
                        {
                            <RadzenStack Gap="0">
                                <RadzenText TextStyle="TextStyle.Overline">@Lead.CustomLabel6</RadzenText>
                                <RadzenText TextStyle="TextStyle.Subtitle2"><b>@Lead.Custom6</b></RadzenText>
                            </RadzenStack>
                        }

                        @if (!string.IsNullOrWhiteSpace(Lead.CustomLabel7))
                        {
                            <RadzenStack Gap="0">
                                <RadzenText TextStyle="TextStyle.Overline">@Lead.CustomLabel7</RadzenText>
                                <RadzenText TextStyle="TextStyle.Subtitle2"><b>@Lead.Custom7</b></RadzenText>
                            </RadzenStack>
                        }

                        @if (!string.IsNullOrWhiteSpace(Lead.CustomLabel8))
                        {
                            <RadzenStack Gap="0">
                                <RadzenText TextStyle="TextStyle.Overline">@Lead.CustomLabel8</RadzenText>
                                <RadzenText TextStyle="TextStyle.Subtitle2"><b>@Lead.Custom8</b></RadzenText>
                            </RadzenStack>
                        }

                        @if (!string.IsNullOrWhiteSpace(Lead.CustomLabel9))
                        {
                            <RadzenStack Gap="0">
                                <RadzenText TextStyle="TextStyle.Overline">@Lead.CustomLabel9</RadzenText>
                                <RadzenText TextStyle="TextStyle.Subtitle2"><b>@Lead.Custom9</b></RadzenText>
                            </RadzenStack>
                        }

                        @if (!string.IsNullOrWhiteSpace(Lead.CustomLabel10))
                        {
                            <RadzenStack Gap="0">
                                <RadzenText TextStyle="TextStyle.Overline">@Lead.CustomLabel10</RadzenText>
                                <RadzenText TextStyle="TextStyle.Subtitle2"><b>@Lead.Custom10</b></RadzenText>
                            </RadzenStack>
                        }
                    </RadzenStack>
                </RadzenFieldset>
            </RadzenCard>
        </RadzenColumn>

        <RadzenColumn>
            <RadzenCard>
                <RadzenFieldset Text="Call Memo">
                    <RadzenText TextStyle="TextStyle.Body2" Style="white-space:pre-wrap">@Lead.CallMemo</RadzenText>
                </RadzenFieldset>


                <RadzenFieldset Text="Disposition">        
                    <RadzenStack>
                        <RadzenStack Gap="0">
                            <RadzenText TextStyle="TextStyle.Overline">Date & Time</RadzenText>
                            <RadzenText TextStyle="TextStyle.Body2">@Lead.DispositionOn?.ToLacalDateTimeOffset(AppUser!.TimeZoneInfoId).DateTime.ToDateTimeString()</RadzenText>
                        </RadzenStack>

                        <RadzenStack Gap="0">
                            <RadzenText TextStyle="TextStyle.Overline">Type</RadzenText>
                            <RadzenText TextStyle="TextStyle.Body2">@Lead.DispositionTypeName</RadzenText>
                        </RadzenStack>

                        <RadzenStack Gap="0">
                            <RadzenText TextStyle="TextStyle.Overline">Comment</RadzenText>
                            <RadzenText TextStyle="TextStyle.Body2" Style="white-space:pre-wrap">@Lead.DispositionComment</RadzenText>
                        </RadzenStack>
                    </RadzenStack>
                </RadzenFieldset>

                <RadzenFieldset Text="Response">
                    <RadzenStack>
                        <RadzenStack Gap="0">
                            <RadzenText TextStyle="TextStyle.Overline">Status</RadzenText>
                            <RadzenText TextStyle="TextStyle.Subtitle2">@Lead.DispositionStatusName</RadzenText>
                        </RadzenStack>

                        <RadzenStack Gap="0">
                            <RadzenText TextStyle="TextStyle.Overline">Comment</RadzenText>
                            <RadzenText TextStyle="TextStyle.Subtitle2" Style="white-space:pre-wrap">@Lead.VerifierComment</RadzenText>
                        </RadzenStack>

                        <RadzenStack Gap="0">
                            <RadzenText TextStyle="TextStyle.Subtitle2">
                                <BooleanBadge BoolValue="Lead.IsBillable" DangerText="Non Billable" GreenText="Billable" />
                            </RadzenText>
                        </RadzenStack>
                    </RadzenStack>
                </RadzenFieldset>
            </RadzenCard>
        </RadzenColumn>
    </RadzenRow>
}

<br />

<PageHeading HeadingText="Comments" />

@if (LeadComments is null)
{
    <em>Loading...</em>
}
else
{
    foreach (var item in LeadComments)
    {
        <LeadCommentTemp LeadComment="item" ZonTimeInfoId="@AppUser!.TimeZoneInfoId" />
        <br />
    }
}

<RadzenCard>
    <RadzenRow>
        <RadzenColumn SizeMD="12">
            <RadzenFieldset Text="Type your comment">
                <EditForm Model="InputComment" FormName="CommentForm" OnValidSubmit="PostComment">
                    <DataAnnotationsValidator />
                    
                    <RadzenStack>
                        <RadzenStack Gap="0">
                            <RadzenTextArea @bind-Value="InputComment.Comment" />
                            <ValidationMessage For="() => InputComment.Comment" class="text-danger" />
                        </RadzenStack>

                        <div>
                            <RadzenButton ButtonType="ButtonType.Submit">Post</RadzenButton>
                        </div>
                    </RadzenStack>
                </EditForm>
            </RadzenFieldset>
        </RadzenColumn>
    </RadzenRow>
</RadzenCard>
