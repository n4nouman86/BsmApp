@page "/LeadTransfer"
@attribute [Authorize(Roles = "Super Admin, Verifier")]
<PageTitle>Transfer Lead</PageTitle>

@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject IDbContextFactory<VentureDbContext> VentureDbFactory
@inject AuthenticationStateProvider authProvider
@inject NavigationManager navManager
@inject NotificationService notify
@inject DialogService dialog
@inject TcpaService tcpaService

<PageHeading HeadingText="Transfer Lead" />

<RadzenCard>
    <RadzenFieldset Text="Agent Info">
        @if (Agent is null)
        {
            <em>No agent is selected...</em>
        }
        else
        {
            <RadzenRow>
                <RadzenColumn>
                    <RadzenStack>
                        <RadzenStack Gap="0">
                            <RadzenText TextStyle="TextStyle.Overline">Full Name</RadzenText>
                            <RadzenText TextStyle="TextStyle.Body1"><b>@Agent.FullName</b></RadzenText>
                        </RadzenStack>

                        <RadzenStack Gap="0">
                            <RadzenText TextStyle="TextStyle.Overline">States</RadzenText>
                            <RadzenText TextStyle="TextStyle.Body1"><b>@Agent.States</b></RadzenText>
                        </RadzenStack>
                    </RadzenStack>
                </RadzenColumn>

                <RadzenColumn>
                    <RadzenStack Gap="5">
                        <div>
                            <RadzenBadge BadgeStyle="BadgeStyle.Warning" Variant="Variant.Outlined">
                                Verifier Notes
                            </RadzenBadge>
                        </div>
                        <RadzenText TextStyle="TextStyle.Body2" Style="white-space:pre-wrap">@Agent.VerifierNotes</RadzenText>
                    </RadzenStack>
                </RadzenColumn>

                <RadzenColumn>
                    <RadzenText TextStyle="TextStyle.Overline">Zip Codes</RadzenText>
                    <RadzenText TextStyle="TextStyle.Body2">@Agent.ZipCodes</RadzenText>
                </RadzenColumn>
                <RadzenColumn>
                    <RadzenStack Gap="5">
                        <div>
                            <RadzenBadge BadgeStyle="BadgeStyle.Danger" Variant="Variant.Outlined">
                                DNC Persons
                            </RadzenBadge>
                        </div>
                        <RadzenStack Gap="0">
                            <RadzenText TextStyle="TextStyle.Body2">David Tom</RadzenText>
                            <RadzenText TextStyle="TextStyle.Body2">Lewis Glow</RadzenText>
                            <RadzenText TextStyle="TextStyle.Body2">Benjamin Glow</RadzenText>
                        </RadzenStack>
                    </RadzenStack>
                </RadzenColumn>
            </RadzenRow>
        }
    </RadzenFieldset>
</RadzenCard>

<br />

<RadzenTemplateForm TItem="Lead" Data="Input" Submit="TransferLead">
    <RadzenRow>
        <RadzenColumn SizeMD="6">
            <RadzenCard>
                <RadzenFieldset Text="Lead Info">
                    <RadzenStack>
                        <RadzenStack Gap="0">
                            <RadzenLabel>Phone Number</RadzenLabel>
                            <RadzenTextBox Name="PhoneNumber" @bind-Value="Input.PhoneNumber" MaxLength="10" Trim Change="CheckTransfer" />
                            <RadzenDataAnnotationValidator Component="PhoneNumber" />

                            @if (TransferLeads is not null)
                            {
                                if (TransferLeads.Any())
                                {
                                    <RadzenTable AllowAlternatingRows>
                                        <RadzenTableBody>
                                            @foreach (var item in TransferLeads)
                                            {
                                                <RadzenTableRow>
                                                    <RadzenTableCell>
                                                        @item.TransferOn.ToString("MMM dd, yyyy")
                                                    </RadzenTableCell>
                                                    <RadzenTableCell>
                                                        @item.AgentFullName
                                                    </RadzenTableCell>
                                                </RadzenTableRow>
                                            }
                                        </RadzenTableBody>
                                    </RadzenTable>
                                }
                                else
                                {
                                    <div>
                                        <RadzenText TextStyle="TextStyle.Caption">
                                            No transfer found.
                                        </RadzenText>
                                    </div>
                                }
                            }

                            @if (!string.IsNullOrWhiteSpace(TcpaMessage))
                            {
                                <div>
                                    <RadzenText TextStyle="TextStyle.Caption">
                                        <strong>TCPA:</strong> @TcpaMessage
                                    </RadzenText>
                                </div>
                            }
                        </RadzenStack>

                        <RadzenStack Gap="0">
                            <RadzenLabel>Select Agent</RadzenLabel>

                            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="5">
                                <RadzenDropDown class="rz-w-100"
                                                Name="AgentId"
                                                @bind-Value="Input.AgentId"
                                                Data="ActiveAgents"
                                                ValueProperty="Id"
                                                TextProperty="Text"
                                                Change="ChangedAgent"
                                                AllowClear
                                                AllowFiltering
                                                FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive" />

                                <div>
                                    <RadzenButton Text="Refresh" Disabled="isAgentRefereshing" Click="RefereshAgents" />
                                </div>
                            </RadzenStack>

                            <RadzenCustomValidator Component="AgentId" Validator="@(() => Input.AgentId != Guid.Empty)" Text="Select agent." />
                        </RadzenStack>

                        <RadzenStack Gap="0">
                            <RadzenLabel>Full Name</RadzenLabel>
                            <RadzenTextBox Name="FullName" @bind-Value="Input.FullName" />
                            <RadzenDataAnnotationValidator Component="FullName" />
                        </RadzenStack>

                        <RadzenStack Gap="0">
                            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween">
                                <RadzenLabel>Date Of Birth</RadzenLabel>
                                <RadzenText TextStyle="TextStyle.Caption">Ex: 20 jan 2001</RadzenText>
                            </RadzenStack>
                            <RadzenTextBox Name="DateOfBirth" @bind-Value="Input.DateOfBirth" />
                            <RadzenDataAnnotationValidator Component="DateOfBirth" />
                        </RadzenStack>

                        <RadzenStack Gap="0">
                            <RadzenLabel>Address</RadzenLabel>
                            <RadzenTextArea Name="Address" @bind-Value="Input.Address" Rows="3" />
                            <RadzenDataAnnotationValidator Component="Address" />
                        </RadzenStack>

                        <RadzenStack Gap="0">
                            <RadzenLabel>Select State</RadzenLabel>

                            <RadzenDropDown Name="StateId"
                                            @bind-Value="Input.StateId"
                                            Data="States"
                                            ValueProperty="Id"
                                            TextProperty="Text"
                                            FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                                            AllowFiltering />

                            <RadzenCustomValidator Component="StateId" Validator="() => Input.StateId != 0" Text="Select state." />
                        </RadzenStack>

                        <RadzenStack Gap="0">
                            <RadzenLabel>Spouse</RadzenLabel>
                            <RadzenDropDown Name="Spouse" @bind-Value="Input.Spouse" Data="@(new List<string> { "Yes", "No" })" />
                            <RadzenDataAnnotationValidator Component="Spouse" />
                        </RadzenStack>

                        @if (Input.Spouse == "Yes")
                        {
                            <RadzenStack Gap="0">
                                <RadzenLabel>Spouse Name</RadzenLabel>
                                <RadzenTextBox Name="SpouseName" @bind-Value="Input.SpouseName" />
                                <RadzenRequiredValidator Component="SpouseName" Text="Spouse name is required." />
                                <RadzenDataAnnotationValidator Component="SpouseName" />
                            </RadzenStack>

                            <RadzenStack Gap="0">
                                <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween">
                                    <RadzenLabel>Spouse Date of Birth</RadzenLabel>
                                    <RadzenText TextStyle="TextStyle.Caption">Ex: 20 jan 2001</RadzenText>
                                </RadzenStack>
                                <RadzenTextBox Name="SpouseDob" @bind-Value="Input.SpouseDob" />
                                <RadzenRequiredValidator Component="SpouseDob" Text="Spouse date of birth is required." />
                                <RadzenDataAnnotationValidator Component="SpouseDob" />
                            </RadzenStack>
                        }
                    </RadzenStack>
                </RadzenFieldset>
            </RadzenCard>
        </RadzenColumn>

        <RadzenColumn SizeMD="6">
            <RadzenCard>
                <RadzenFieldset Text="Auto & Home Info">
                    <RadzenStack>
                        <RadzenStack Gap="0">
                            <RadzenLabel>Current Auto Carrier</RadzenLabel>
                            <RadzenTextBox Name="CurrentAutoCarrier" @bind-Value="Input.CurrentAutoCarrier" />
                            <RadzenDataAnnotationValidator Component="CurrentAutoCarrier" />
                        </RadzenStack>

                        <RadzenStack Gap="0">
                            <RadzenLabel>Any Lapses</RadzenLabel>
                            <RadzenDropDown Name="AnyLapses" @bind-Value="Input.AnyLapses" Data="@(new List<string> { "Yes", "No" })" />
                            <RadzenDataAnnotationValidator Component="AnyLapses" />
                        </RadzenStack>

                        <RadzenStack Gap="0">
                            <RadzenLabel>Make and Model</RadzenLabel>
                            <RadzenTextArea Name="MakeAndModel" @bind-Value="Input.MakeAndModel" Rows="5" />
                            <RadzenDataAnnotationValidator Component="MakeAndModel" />
                        </RadzenStack>

                        <RadzenStack Gap="0">
                            <RadzenLabel>Accidents</RadzenLabel>
                            <RadzenDropDown Name="Accidents" @bind-Value="Input.Accidents" Data="@(new List<string> { "No", "1", "2" })" />
                            <RadzenDataAnnotationValidator Component="Accidents" />
                        </RadzenStack>

                        <RadzenStack Gap="0">
                            <RadzenLabel>Tickets</RadzenLabel>
                            <RadzenDropDown Name="Tickets" @bind-Value="Input.Tickets" Data="@(new List<string> { "No", "1", "2" })" />
                            <RadzenDataAnnotationValidator Component="Tickets" />
                        </RadzenStack>

                        <RadzenStack Gap="0">
                            <RadzenLabel>Home Owner</RadzenLabel>
                            <RadzenDropDown Name="HomeOwner" @bind-Value="Input.HomeOwner" Data="@(new List<string> { "Yes", "No" })" />
                            <RadzenDataAnnotationValidator Component="HomeOwner" />
                        </RadzenStack>

                        @if (Input.HomeOwner == "Yes")
                        {
                            <RadzenStack Gap="0">
                                <RadzenLabel>Home Type</RadzenLabel>
                                <RadzenTextBox Name="HomeType" @bind-Value="Input.HomeType" />
                                <RadzenRequiredValidator Component="HomeType" Text="Home type is required." />
                                <RadzenDataAnnotationValidator Component="HomeType" />
                            </RadzenStack>

                            <RadzenStack Gap="0">
                                <RadzenLabel>Current Home Carrier</RadzenLabel>
                                <RadzenTextBox Name="CurrentHomeCarrier" @bind-Value="Input.CurrentHomeCarrier" />
                                <RadzenRequiredValidator Component="CurrentHomeCarrier" Text="Current home carrier is required." />
                                <RadzenDataAnnotationValidator Component="CurrentHomeCarrier" />
                            </RadzenStack>

                            <RadzenStack Gap="0">
                                <RadzenLabel>Any Claim In Past 3 Years</RadzenLabel>
                                <RadzenDropDown Name="AnyClaimInPastThreeYears" @bind-Value="Input.AnyClaimInPastThreeYears" Data="@(new List<string> { "Yes", "No" })" class="w-100" />
                                <RadzenRequiredValidator Component="AnyClaimInPastThreeYears" Text="Any claim in past three years is required." />
                                <RadzenDataAnnotationValidator Component="AnyClaimInPastThreeYears" />
                            </RadzenStack>
                        }
                    </RadzenStack>
                </RadzenFieldset>
            </RadzenCard>
        </RadzenColumn>

        @if (!string.IsNullOrWhiteSpace(Input.CustomLabel1))
        {
            <RadzenColumn SizeMD="12">
                <RadzenCard>
                    <RadzenFieldset Text="Custom Fields">
                        <RadzenRow>
                            <RadzenColumn SizeMD="6">
                                <RadzenStack>
                                    @if (!string.IsNullOrWhiteSpace(Input.CustomLabel1))
                                    {
                                        <RadzenStack Gap="0">
                                            <RadzenLabel>@Input.CustomLabel1</RadzenLabel>
                                            <RadzenTextBox Name="Custom1" @bind-Value="Input.Custom1" />
                                            <RadzenRequiredValidator Component="Custom1" Text="This is required." />
                                            <RadzenDataAnnotationValidator Component="Custom1" />
                                        </RadzenStack>
                                    }

                                    @if (!string.IsNullOrWhiteSpace(Input.CustomLabel2))
                                    {
                                        <RadzenStack Gap="0">
                                            <RadzenLabel>@Input.CustomLabel2</RadzenLabel>
                                            <RadzenTextBox Name="Custom2" @bind-Value="Input.Custom2" />
                                            <RadzenRequiredValidator Component="Custom2" Text="This is required." />
                                            <RadzenDataAnnotationValidator Component="Custom2" />
                                        </RadzenStack>
                                    }

                                    @if (!string.IsNullOrWhiteSpace(Input.CustomLabel3))
                                    {
                                        <RadzenStack Gap="0">
                                            <RadzenLabel>@Input.CustomLabel3</RadzenLabel>
                                            <RadzenTextBox Name="Custom3" @bind-Value="Input.Custom3" />
                                            <RadzenRequiredValidator Component="Custom3" Text="This is required." />
                                            <RadzenDataAnnotationValidator Component="Custom3" />
                                        </RadzenStack>
                                    }

                                    @if (!string.IsNullOrWhiteSpace(Input.CustomLabel4))
                                    {
                                        <RadzenStack Gap="0">
                                            <RadzenLabel>@Input.CustomLabel4</RadzenLabel>
                                            <RadzenTextBox Name="Custom4" @bind-Value="Input.Custom4" />
                                            <RadzenRequiredValidator Component="Custom4" Text="This is required." />
                                            <RadzenDataAnnotationValidator Component="Custom4" />
                                        </RadzenStack>
                                    }

                                    @if (!string.IsNullOrWhiteSpace(Input.CustomLabel5))
                                    {
                                        <RadzenStack Gap="0">
                                            <RadzenLabel>@Input.CustomLabel5</RadzenLabel>
                                            <RadzenTextBox Name="Custom5" @bind-Value="Input.Custom5" />
                                            <RadzenRequiredValidator Component="Custom5" Text="This is required." />
                                            <RadzenDataAnnotationValidator Component="Custom5" />
                                        </RadzenStack>
                                    }
                                </RadzenStack>
                            </RadzenColumn>

                            <RadzenColumn SizeMD="6">
                                <RadzenStack>
                                    @if (!string.IsNullOrWhiteSpace(Input.CustomLabel6))
                                    {
                                        <RadzenStack Gap="0">
                                            <RadzenLabel>@Input.CustomLabel6</RadzenLabel>
                                            <RadzenTextBox Name="Custom6" @bind-Value="Input.Custom6" />
                                            <RadzenRequiredValidator Component="Custom6" Text="This is required." />
                                            <RadzenDataAnnotationValidator Component="Custom6" />
                                        </RadzenStack>
                                    }

                                    @if (!string.IsNullOrWhiteSpace(Input.CustomLabel7))
                                    {
                                        <RadzenStack Gap="0">
                                            <RadzenLabel>@Input.CustomLabel7</RadzenLabel>
                                            <RadzenTextBox Name="Custom7" @bind-Value="Input.Custom7" />
                                            <RadzenRequiredValidator Component="Custom7" Text="This is required." />
                                            <RadzenDataAnnotationValidator Component="Custom7" />
                                        </RadzenStack>
                                    }

                                    @if (!string.IsNullOrWhiteSpace(Input.CustomLabel8))
                                    {
                                        <RadzenStack Gap="0">
                                            <RadzenLabel>@Input.CustomLabel8</RadzenLabel>
                                            <RadzenTextBox Name="Custom8" @bind-Value="Input.Custom8" />
                                            <RadzenRequiredValidator Component="Custom8" Text="This is required." />
                                            <RadzenDataAnnotationValidator Component="Custom8" />
                                        </RadzenStack>
                                    }

                                    @if (!string.IsNullOrWhiteSpace(Input.CustomLabel9))
                                    {
                                        <RadzenStack Gap="0">
                                            <RadzenLabel>@Input.CustomLabel9</RadzenLabel>
                                            <RadzenTextBox Name="Custom9" @bind-Value="Input.Custom9" />
                                            <RadzenRequiredValidator Component="Custom9" Text="This is required." />
                                            <RadzenDataAnnotationValidator Component="Custom9" />
                                        </RadzenStack>
                                    }

                                    @if (!string.IsNullOrWhiteSpace(Input.CustomLabel10))
                                    {
                                        <RadzenStack Gap="0">
                                            <RadzenLabel>@Input.CustomLabel10</RadzenLabel>
                                            <RadzenTextBox Name="Custom10" @bind-Value="Input.Custom10" />
                                            <RadzenRequiredValidator Component="Custom10" Text="This is required." />
                                            <RadzenDataAnnotationValidator Component="Custom10" />
                                        </RadzenStack>
                                    }
                                </RadzenStack>
                            </RadzenColumn>
                        </RadzenRow>
                    </RadzenFieldset>
                </RadzenCard>
            </RadzenColumn>   
        }

        <RadzenColumn SizeMD="12">
            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween">
                <RadzenStack Orientation="Orientation.Horizontal">
                    <RadzenButton ButtonType="ButtonType.Submit" Disabled="isTransfering">
                        Transfer Lead
                    </RadzenButton>

                    <RadzenButton ButtonType="ButtonType.Button" ButtonStyle="ButtonStyle.Danger" Click="ResetForm">
                        Reset Form
                    </RadzenButton>
                </RadzenStack>
                
                <RadzenStack Orientation="Orientation.Horizontal">
                    <RadzenDropDown @bind-Value="CalledLeadStatus"
                        Data="@(new List<string> { "Call Back", "Not Interested", "Already Client", "Do Not Call" })"
                        />                    
                    
                    <RadzenButton ButtonType="ButtonType.Button" ButtonStyle="ButtonStyle.Success" Click="SaveLead" Disabled="isTransfering">
                        Save Lead
                    </RadzenButton>
                </RadzenStack>
            </RadzenStack>
        </RadzenColumn>
    </RadzenRow>
</RadzenTemplateForm>


