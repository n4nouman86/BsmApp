@page "/WhitelistedIpIndex"
@attribute [Authorize(Roles = "Super Admin")]
<PageTitle>Whitelisted IPs</PageTitle>

@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject DialogService dialogService

<PageHeading HeadingText="Whitelisted IPs" />

<RadzenStack AlignItems="AlignItems.Start">
    <RadzenButton Icon="add" Text="Add New IP" ButtonStyle="ButtonStyle.Primary" Click="OpenCreate" />
</RadzenStack>

<br />

<RadzenCard>
    @if (WhitelistedIps is null)
    {
        <em>Loading...</em>
    }
    else
    {
        <RadzenDataGrid Data="@WhitelistedIps" EmptyText="No whitelisted IPs to display">

            <Columns>
                <RadzenDataGridColumn Property="IpAddress" Title="IP Address" />
                <RadzenDataGridColumn Property="Description" Title="Description" />
                <RadzenDataGridColumn Property="CreatedOn" Title="Created On" FormatString="{0:MMM dd, yyyy}" TextAlign="TextAlign.Center" Width="150px" />

                <RadzenDataGridColumn Title="Action" TextAlign="TextAlign.Center" Width="150px">
                    <Template Context="ip">
                        <RadzenButton Icon="edit" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Secondary"
                            Click="@(() => OpenEdit(ip.Id))" title="Edit" />

                        <RadzenButton Icon="delete" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Danger"
                            Click="@(() => DeleteWhitelistedIp(ip))" title="Delete" />
                    </Template>
                </RadzenDataGridColumn>
            </Columns>
        </RadzenDataGrid>
    }
</RadzenCard>
