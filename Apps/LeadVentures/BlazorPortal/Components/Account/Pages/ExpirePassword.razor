@page "/Account/ExpirePassword"
<PageTitle>Expire Password</PageTitle>

@using System.ComponentModel.DataAnnotations
@using BlazorPortal.Components.Account
@using Microsoft.AspNetCore.Identity
@using BlazorPortal.Data

@inject UserManager<ApplicationUser> UserManager
@inject SignInManager<ApplicationUser> SignInManager
@inject IdentityRedirectManager RedirectManager

<RadzenRow>
    <RadzenColumn SizeMD="12">
        <StatusMessage Message="@message" />

        <RadzenCard>
            <RadzenStack Gap="5">
                <RadzenText TextStyle="TextStyle.H5">Change Password</RadzenText>
                <RadzenText TextStyle="TextStyle.Caption">Change your password..</RadzenText>
                <hr />
            </RadzenStack>

            <EditForm Model="Input" FormName="change-password" OnValidSubmit="OnValidSubmitAsync" method="post">
                <DataAnnotationsValidator />

                <RadzenStack>
                    <RadzenStack Gap="0">
                        <RadzenLabel>Old password</RadzenLabel>
                        <InputText type="password" @bind-Value="Input.OldPassword" id="Input.OldPassword" class="rz-textbox" autocomplete="current-password" aria-required="true" placeholder="Enter the old password" />
                        <ValidationMessage For="() => Input.OldPassword" class="rz-message rz-messages-error" />
                    </RadzenStack>

                    <RadzenStack Gap="0">
                        <RadzenLabel>New password</RadzenLabel>
                        <InputText type="password" @bind-Value="Input.NewPassword" id="Input.NewPassword" class="rz-textbox" autocomplete="new-password" aria-required="true" placeholder="Enter the new password" />
                        <ValidationMessage For="() => Input.NewPassword" class="rz-message rz-messages-error" />
                    </RadzenStack>

                    <RadzenStack Gap="0">
                        <RadzenLabel>Confirm password</RadzenLabel>
                        <InputText type="password" @bind-Value="Input.ConfirmPassword" id="Input.ConfirmPassword" class="rz-textbox" autocomplete="new-password" aria-required="true" placeholder="Enter the new password" />
                        <ValidationMessage For="() => Input.ConfirmPassword" class="rz-message rz-messages-error" />
                    </RadzenStack>

                    <div>
                        <button type="submit" class="rz-button rz-button-md rz-variant-filled rz-primary rz-shade-default">
                            Update password
                        </button>
                    </div>
                </RadzenStack>
            </EditForm>
        </RadzenCard>
    </RadzenColumn>
</RadzenRow>




