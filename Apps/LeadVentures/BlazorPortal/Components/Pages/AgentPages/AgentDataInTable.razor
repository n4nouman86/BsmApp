
<div class="col-md-12">
    <RadzenDataGrid Data="@Agents" AllowColumnResize AllowColumnReorder AllowSorting>
        <Columns>
            <RadzenDataGridColumn Property="FullName" Title="Agent Name" />
            
            <RadzenDataGridColumn Property="States" Title="States" TextAlign="TextAlign.Center">
                <Template Context="agent">
                    <RadzenBadge Variant="Variant.Flat" BadgeStyle="BadgeStyle.Light">@agent.States</RadzenBadge>
                </Template>
            </RadzenDataGridColumn>

            <RadzenDataGridColumn Title="Online" TextAlign="TextAlign.Center">
                <Template Context="agent">
                    <BooleanBadge BoolValue="agent.IsOnline" GreenText="yes" DangerText="no" />
                </Template>
            </RadzenDataGridColumn>

            <RadzenDataGridColumn Property="ScheduleFrom" Title="Schedule From" FormatString="{0:hh':'mm tt}" TextAlign="TextAlign.Center" />
            <RadzenDataGridColumn Property="ScheduleTo" Title="Schedule To" FormatString="{0:hh':'mm tt}" TextAlign="TextAlign.Center" />
            <RadzenDataGridColumn Property="PauseTimer" Title="Pause (min)" FormatString="{0:N2}" TextAlign="TextAlign.Center" />
            <RadzenDataGridColumn Property="DailyCap" Title="Daily Cap" TextAlign="TextAlign.Center" />
            <RadzenDataGridColumn Property="TodayTransfer" Title="Today Transfer" TextAlign="TextAlign.Center" />
            <RadzenDataGridColumn Property="CoolOffTime" Title="Cool Off Time (min)" FormatString="{0:N2}" TextAlign="TextAlign.Center" />
            <RadzenDataGridColumn Property="LastTransferAgo" Title="Last Transfer Ago" TextAlign="TextAlign.Center" />
        </Columns>
    </RadzenDataGrid>
</div>



@code {
    [Parameter]
    public IEnumerable<vwStatusAgent> Agents { get; set; } = Enumerable.Empty<vwStatusAgent>();
}
