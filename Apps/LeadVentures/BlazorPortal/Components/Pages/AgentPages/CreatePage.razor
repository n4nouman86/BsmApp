@page "/AgentCreate"
@attribute [Authorize(Roles = "Super Admin")]
<PageTitle>Add New Agent</PageTitle>

@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject NotificationService notify

<PageHeading HeadingText="Add New Agent" />

<EditForm Model="Input" OnValidSubmit="CreateAgent">
    <DataAnnotationsValidator />

    <RadzenRow>
        <RadzenColumn SizeMD="6">
            <RadzenCard>
                <RadzenFieldset Text="Agent Info">
                    <RadzenStack>
                        <RadzenStack Gap="0">
                            <RadzenLabel>Select User</RadzenLabel>
                            <RadzenDropDown @bind-Value="Input.AppUserId" Data="AgentAppUsers" TextProperty="Text" ValueProperty="Id" />
                            <ValidationMessage For="() => Input.AppUserId" class="rz-messages-error" />
                        </RadzenStack>

                        <RadzenStack Gap="0">
                            <RadzenLabel>Full Name</RadzenLabel>
                            <RadzenTextBox @bind-Value="Input.FullName" />
                            <ValidationMessage For="() => Input.FullName" class="rz-messages-error" />
                        </RadzenStack>

                        <RadzenStack Gap="0">
                            <RadzenLabel>Agent Email</RadzenLabel>
                            <RadzenTextBox @bind-Value="Input.AgentEmail" />
                            <ValidationMessage For="() => Input.AgentEmail" class="rz-messages-error" />
                        </RadzenStack>

                        <RadzenStack Gap="0">
                            <RadzenLabel>Phone Number</RadzenLabel>
                            <RadzenTextBox @bind-Value="Input.PhoneNumber" />
                            <ValidationMessage For="() => Input.PhoneNumber" class="rz-messages-error" />
                        </RadzenStack>

                        <RadzenStack Gap="0">
                            <RadzenLabel>Address (optional)</RadzenLabel>
                            <RadzenTextArea @bind-Value="Input.Address" />
                            <ValidationMessage For="() => Input.Address" class="rz-messages-error" />
                        </RadzenStack>
                    </RadzenStack>
                </RadzenFieldset>
            </RadzenCard>
        </RadzenColumn>

        <RadzenColumn SizeMD="6">
            <RadzenCard>
                <RadzenFieldset Text="Transfer Info">
                    <RadzenStack>
                        <RadzenStack Gap="0">
                            <RadzenLabel>Transfer No DID (optional)</RadzenLabel>
                            <RadzenTextBox @bind-Value="Input.TransferNoDid" />
                            <ValidationMessage For="() => Input.TransferNoDid" class="rz-messages-error" />
                        </RadzenStack>

                        <RadzenStack Gap="0">
                            <RadzenLabel>Cost Per Lead (optional)</RadzenLabel>
                            <RadzenNumeric @bind-Value="Input.CostPerLead" />
                            <ValidationMessage For="() => Input.CostPerLead" class="rz-messages-error" />
                        </RadzenStack>

                        <RadzenStack Gap="0">
                            <RadzenLabel>Daily Cap</RadzenLabel>
                            <RadzenNumeric @bind-Value="Input.DailyCap" />
                            <ValidationMessage For="() => Input.DailyCap" class="rz-messages-error" />
                        </RadzenStack>

                        <RadzenStack Gap="0">
                            <RadzenLabel>Weekly Cap</RadzenLabel>
                            <RadzenNumeric @bind-Value="Input.WeeklyCap" />
                            <ValidationMessage For="() => Input.WeeklyCap" class="rz-messages-error" />
                        </RadzenStack>

                        <RadzenStack Gap="0">
                            <RadzenLabel>Max Cap</RadzenLabel>
                            <RadzenNumeric @bind-Value="Input.MaxCap" />
                            <ValidationMessage For="() => Input.MaxCap" class="rz-messages-error" />
                        </RadzenStack>
                    </RadzenStack>
                </RadzenFieldset>
            </RadzenCard>
        </RadzenColumn>

        <RadzenColumn SizeMD="6">
            <RadzenCard>
                <RadzenFieldset Text="Campaign Info">
                    <RadzenStack>
                        <RadzenStack Gap="0">
                            <RadzenLabel>Cool Off Time</RadzenLabel>
                            <RadzenNumeric @bind-Value="Input.CoolOffTime" />
                            <ValidationMessage For="() => Input.CoolOffTime" class="rz-messages-error" />
                        </RadzenStack>

                        <RadzenStack Gap="0">
                            <RadzenLabel>Cool Off Max Leads</RadzenLabel>
                            <RadzenNumeric @bind-Value="Input.CoolOffMaxLeads" />
                            <ValidationMessage For="() => Input.CoolOffMaxLeads" class="rz-messages-error" />
                        </RadzenStack>

                        <RadzenStack Gap="0">
                            <RadzenLabel>ZipCodes (optional)</RadzenLabel>
                            <RadzenTextArea @bind-Value="Input.ZipCodes" />
                            <ValidationMessage For="() => Input.ZipCodes" class="rz-messages-error" />
                        </RadzenStack>

                        <RadzenStack Gap="0">
                            <RadzenLabel>States</RadzenLabel>
                            <RadzenTextBox @bind-Value="Input.States" />
                            <ValidationMessage For="() => Input.States" class="rz-messages-error" />
                        </RadzenStack>

                        <RadzenStack Gap="0">
                            <RadzenLabel>Country</RadzenLabel>
                            <RadzenTextBox @bind-Value="Input.Country" />
                            <ValidationMessage For="() => Input.Country" class="rz-messages-error" />
                        </RadzenStack>
                    </RadzenStack>
                </RadzenFieldset>
            </RadzenCard>
        </RadzenColumn>

        <RadzenColumn SizeMD="6">
            <RadzenCard>
                <RadzenFieldset Text="Campaign Info">
                    <RadzenStack>
                        <RadzenStack Gap="0">
                            <RadzenStack Orientation="Orientation.Horizontal" Gap="10" AlignItems="AlignItems.Center">
                                <RadzenCheckBox @bind-Value="Input.IsOnline" />
                                <RadzenLabel>Agent Is Online</RadzenLabel>
                            </RadzenStack>
                            <ValidationMessage For="() => Input.IsOnline" class="rz-messages-error" />
                        </RadzenStack>

                        <RadzenStack Gap="0">
                            <RadzenStack Orientation="Orientation.Horizontal" Gap="10" AlignItems="AlignItems.Center">
                                <RadzenCheckBox @bind-Value="Input.DoNotAllowDnc" />
                                <RadzenLabel>Do Not Allow Dnc</RadzenLabel>
                            </RadzenStack>
                            <ValidationMessage For="() => Input.DoNotAllowDnc" class="rz-messages-error" />
                        </RadzenStack>

                        <RadzenStack Gap="0">
                            <RadzenLabel>Campaign Status</RadzenLabel>
                            <RadzenDropDown @bind-Value="Input.CampaignStatus" Data="CampaignStatuses" />
                            <ValidationMessage For="() => Input.CampaignStatus" class="rz-messages-error" />
                        </RadzenStack>

                        <RadzenStack Gap="0">
                            <RadzenLabel>Verifier Notes</RadzenLabel>
                            <RadzenTextArea @bind-Value="Input.VerifierNotes" rows="8" />
                            <ValidationMessage For="() => Input.VerifierNotes" class="rz-messages-error" />
                        </RadzenStack>
                    </RadzenStack>
                </RadzenFieldset>
            </RadzenCard>
        </RadzenColumn>

        <RadzenColumn SizeMD="12">
            <RadzenCard>
                <RadzenFieldset Text="Custom Fields">
                    <RadzenRow>
                        <RadzenColumn SizeMD="6">
                            <RadzenStack>
                                <RadzenStack Gap="0">
                                    <RadzenLabel>Custom 1 Label (optional)</RadzenLabel>
                                    <RadzenTextBox @bind-Value="Input.CustomLabel1" />
                                    <ValidationMessage For="() => Input.CustomLabel1" class="rz-messages-error" />
                                </RadzenStack>

                                <RadzenStack Gap="0">
                                    <RadzenLabel>Custom 2 Label (optional)</RadzenLabel>
                                    <RadzenTextBox @bind-Value="Input.CustomLabel2" />
                                    <ValidationMessage For="() => Input.CustomLabel2" class="rz-messages-error" />
                                </RadzenStack>

                                <RadzenStack Gap="0">
                                    <RadzenLabel>Custom 3 Label (optional)</RadzenLabel>
                                    <RadzenTextBox @bind-Value="Input.CustomLabel3" />
                                    <ValidationMessage For="() => Input.CustomLabel3" class="rz-messages-error" />
                                </RadzenStack>

                                <RadzenStack Gap="0">
                                    <RadzenLabel>Custom 4 Label (optional)</RadzenLabel>
                                    <RadzenTextBox @bind-Value="Input.CustomLabel4" />
                                    <ValidationMessage For="() => Input.CustomLabel4" class="rz-messages-error" />
                                </RadzenStack>

                                <RadzenStack Gap="0">
                                    <RadzenLabel>Custom 5 Label (optional)</RadzenLabel>
                                    <RadzenTextBox @bind-Value="Input.CustomLabel5" />
                                    <ValidationMessage For="() => Input.CustomLabel5" class="rz-messages-error" />
                                </RadzenStack>
                            </RadzenStack>
                        </RadzenColumn>

                        <RadzenColumn SizeMD="6">
                            <RadzenStack>
                                <RadzenStack Gap="0">
                                    <RadzenLabel>Custom 6 Label (optional)</RadzenLabel>
                                    <RadzenTextBox @bind-Value="Input.CustomLabel6" />
                                    <ValidationMessage For="() => Input.CustomLabel6" class="rz-messages-error" />
                                </RadzenStack>

                                <RadzenStack Gap="0">
                                    <RadzenLabel>Custom 7 Label (optional)</RadzenLabel>
                                    <RadzenTextBox @bind-Value="Input.CustomLabel7" />
                                    <ValidationMessage For="() => Input.CustomLabel7" class="rz-messages-error" />
                                </RadzenStack>

                                <RadzenStack Gap="0">
                                    <RadzenLabel>Custom 8 Label (optional)</RadzenLabel>
                                    <RadzenTextBox @bind-Value="Input.CustomLabel8" />
                                    <ValidationMessage For="() => Input.CustomLabel8" class="rz-messages-error" />
                                </RadzenStack>

                                <RadzenStack Gap="0">
                                    <RadzenLabel>Custom 9 Label (optional)</RadzenLabel>
                                    <RadzenTextBox @bind-Value="Input.CustomLabel9" />
                                    <ValidationMessage For="() => Input.CustomLabel9" class="rz-messages-error" />
                                </RadzenStack>

                                <RadzenStack Gap="0">
                                    <RadzenLabel>Custom 10 Label (optional)</RadzenLabel>
                                    <RadzenTextBox @bind-Value="Input.CustomLabel10" />
                                    <ValidationMessage For="() => Input.CustomLabel10" class="rz-messages-error" />
                                </RadzenStack>
                            </RadzenStack>
                        </RadzenColumn>
                    </RadzenRow>
                </RadzenFieldset>
            </RadzenCard>
        </RadzenColumn>

        <RadzenColumn SizeMD="12">
            <RadzenCard>
                <RadzenFieldset Text="Agent Schedule">
                    <RadzenRow>
                        <RadzenColumn SizeMD="6">
                            <RadzenStack>
                                <RadzenStack Gap="0">
                                    <RadzenLabel>Mon Schedule From (optional)</RadzenLabel>
                                    <RadzenDatePicker @bind-Value="Input.MonScheduleFrom" ShowTime ShowSeconds="false" TimeOnly HourFormat="12" DateFormat="hh:mm tt" AllowClear />
                                    <ValidationMessage For="() => Input.MonScheduleFrom" class="rz-messages-error" />
                                </RadzenStack>

                                <RadzenStack Gap="0">
                                    <RadzenLabel>Tue Schedule From (optional)</RadzenLabel>
                                    <RadzenDatePicker @bind-Value="Input.TueScheduleFrom" ShowTime ShowSeconds="false" TimeOnly HourFormat="12" DateFormat="hh:mm tt" AllowClear />
                                    <ValidationMessage For="() => Input.TueScheduleFrom" class="rz-messages-error" />
                                </RadzenStack>

                                <RadzenStack Gap="0">
                                    <RadzenLabel>Wed Schedule From (optional)</RadzenLabel>
                                    <RadzenDatePicker @bind-Value="Input.WedScheduleFrom" ShowTime ShowSeconds="false" TimeOnly HourFormat="12" DateFormat="hh:mm tt" AllowClear />
                                    <ValidationMessage For="() => Input.WedScheduleFrom" class="rz-messages-error" />
                                </RadzenStack>

                                <RadzenStack Gap="0">
                                    <RadzenLabel>Thu Schedule From (optional)</RadzenLabel>
                                    <RadzenDatePicker @bind-Value="Input.ThuScheduleFrom" ShowTime ShowSeconds="false" TimeOnly HourFormat="12" DateFormat="hh:mm tt" AllowClear />
                                    <ValidationMessage For="() => Input.ThuScheduleFrom" class="rz-messages-error" />
                                </RadzenStack>

                                <RadzenStack Gap="0">
                                    <RadzenLabel>Fri Schedule From (optional)</RadzenLabel>
                                    <RadzenDatePicker @bind-Value="Input.FriScheduleFrom" ShowTime ShowSeconds="false" TimeOnly HourFormat="12" DateFormat="hh:mm tt" AllowClear />
                                    <ValidationMessage For="() => Input.FriScheduleFrom" class="rz-messages-error" />
                                </RadzenStack>

                                <RadzenStack Gap="0">
                                    <RadzenLabel>Sat Schedule From (optional)</RadzenLabel>
                                    <RadzenDatePicker @bind-Value="Input.SatScheduleFrom" ShowTime ShowSeconds="false" TimeOnly HourFormat="12" DateFormat="hh:mm tt" AllowClear />
                                    <ValidationMessage For="() => Input.SatScheduleFrom" class="rz-messages-error" />
                                </RadzenStack>

                                <RadzenStack Gap="0">
                                    <RadzenLabel>Sun Schedule From (optional)</RadzenLabel>
                                    <RadzenDatePicker @bind-Value="Input.SunScheduleFrom" ShowTime ShowSeconds="false" TimeOnly HourFormat="12" DateFormat="hh:mm tt" AllowClear />
                                    <ValidationMessage For="() => Input.SunScheduleFrom" class="rz-messages-error" />
                                </RadzenStack>
                            </RadzenStack>
                        </RadzenColumn>

                        <RadzenColumn SizeMD="6">
                            <RadzenStack>
                                <RadzenStack Gap="0">
                                    <RadzenLabel>Mon Schedule To (optional)</RadzenLabel>
                                    <RadzenDatePicker @bind-Value="Input.MonScheduleTo" ShowTime ShowSeconds="false" TimeOnly HourFormat="12" DateFormat="hh:mm tt" AllowClear />
                                    <ValidationMessage For="() => Input.MonScheduleTo" class="rz-messages-error" />
                                </RadzenStack>

                                <RadzenStack Gap="0">
                                    <RadzenLabel>Tue Schedule To (optional)</RadzenLabel>
                                    <RadzenDatePicker @bind-Value="Input.TueScheduleTo" ShowTime ShowSeconds="false" TimeOnly HourFormat="12" DateFormat="hh:mm tt" AllowClear />
                                    <ValidationMessage For="() => Input.TueScheduleTo" class="rz-messages-error" />
                                </RadzenStack>

                                <RadzenStack Gap="0">
                                    <RadzenLabel>Wed Schedule To (optional)</RadzenLabel>
                                    <RadzenDatePicker @bind-Value="Input.WedScheduleTo" ShowTime ShowSeconds="false" TimeOnly HourFormat="12" DateFormat="hh:mm tt" AllowClear />
                                    <ValidationMessage For="() => Input.WedScheduleTo" class="rz-messages-error" />
                                </RadzenStack>

                                <RadzenStack Gap="0">
                                    <RadzenLabel>Thu Schedule To (optional)</RadzenLabel>
                                    <RadzenDatePicker @bind-Value="Input.ThuScheduleTo" ShowTime ShowSeconds="false" TimeOnly HourFormat="12" DateFormat="hh:mm tt" AllowClear />
                                    <ValidationMessage For="() => Input.ThuScheduleTo" class="rz-messages-error" />
                                </RadzenStack>

                                <RadzenStack Gap="0">
                                    <RadzenLabel>Fri Schedule To (optional)</RadzenLabel>
                                    <RadzenDatePicker @bind-Value="Input.FriScheduleTo" ShowTime ShowSeconds="false" TimeOnly HourFormat="12" DateFormat="hh:mm tt" AllowClear />
                                    <ValidationMessage For="() => Input.FriScheduleTo" class="rz-messages-error" />
                                </RadzenStack>

                                <RadzenStack Gap="0">
                                    <RadzenLabel>Sat Schedule To (optional)</RadzenLabel>
                                    <RadzenDatePicker @bind-Value="Input.SatScheduleTo" ShowTime ShowSeconds="false" TimeOnly HourFormat="12" DateFormat="hh:mm tt" AllowClear />
                                    <ValidationMessage For="() => Input.SatScheduleTo" class="rz-messages-error" />
                                </RadzenStack>

                                <RadzenStack Gap="0">
                                    <RadzenLabel>Sun Schedule To (optional)</RadzenLabel>
                                    <RadzenDatePicker @bind-Value="Input.SunScheduleTo" ShowTime ShowSeconds="false" TimeOnly HourFormat="12" DateFormat="hh:mm tt" AllowClear />
                                    <ValidationMessage For="() => Input.SunScheduleTo" class="rz-messages-error" />
                                </RadzenStack>
                            </RadzenStack>
                        </RadzenColumn>
                    </RadzenRow>
                </RadzenFieldset>
            </RadzenCard>
        </RadzenColumn>

        <RadzenColumn SizeMD="6">
            <RadzenCard>
                <RadzenFieldset Text="Bonus Info">
                    <RadzenStack>
                        <RadzenStack Gap="0">
                            <RadzenLabel>Select Employee (optional)</RadzenLabel>
                            <RadzenDropDown @bind-Value="Input.EmployeeId" Data="Employees" TextProperty="Name" ValueProperty="Id" AllowClear />
                            <ValidationMessage For="() => Input.EmployeeId" class="rz-messages-error" />
                        </RadzenStack>
                    </RadzenStack>
                </RadzenFieldset>
            </RadzenCard>
        </RadzenColumn>
    </RadzenRow>

    <br />

    <div>
        <RadzenButton ButtonType="ButtonType.Submit">Create</RadzenButton>
    </div>
</EditForm>





