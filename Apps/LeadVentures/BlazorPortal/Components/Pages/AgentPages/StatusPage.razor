@page "/AgentStatus"
@attribute [Authorize(Roles = "Super Admin,Verifier")]
<PageTitle>Agents Status</PageTitle>

@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject NotificationService notify

<PageHeading HeadingText="Agents Status" />


<RadzenCard>
    @if (TotalTransfer is null)
    {
        <em>Loading...</em>
    }
    else
    {
        <RadzenRow>
            <RadzenColumn>
                <RadzenCard Variant="Variant.Outlined" class="py-1 ps-3 pe-5">
                    <RadzenText TextStyle="TextStyle.Overline">Target</RadzenText>
                    <RadzenText TextStyle="TextStyle.H5">@TotalTransfer.Target</RadzenText>
                </RadzenCard>
            </RadzenColumn>

            <RadzenColumn>
                <RadzenCard Variant="Variant.Outlined" class="py-1 ps-3 pe-5">
                    <RadzenText TextStyle="TextStyle.Overline">Transfers</RadzenText>
                    <RadzenText TextStyle="TextStyle.H5">@TotalTransfer.Transfer</RadzenText>
                </RadzenCard>
            </RadzenColumn>

            <RadzenColumn>
                <RadzenCard Variant="Variant.Outlined" class="py-1 ps-3 pe-5">
                    <RadzenText TextStyle="TextStyle.Overline">Remainging</RadzenText>
                    <RadzenText TextStyle="TextStyle.H5">@(TotalTransfer.Target - TotalTransfer.Transfer)</RadzenText>
                </RadzenCard>
            </RadzenColumn>

            <RadzenColumn>
                <RadzenCard Variant="Variant.Outlined" class="py-1 ps-3 pe-5">
                    <RadzenText TextStyle="TextStyle.Overline">Under Review</RadzenText>
                    <RadzenText TextStyle="TextStyle.H5">@TotalTransfer.UnderReview</RadzenText>
                </RadzenCard>
            </RadzenColumn>

            <RadzenColumn>
                <RadzenCard Variant="Variant.Outlined" class="py-1 ps-3 pe-5">
                    <RadzenText TextStyle="TextStyle.Overline">Approved</RadzenText>
                    <RadzenText TextStyle="TextStyle.H5">@TotalTransfer.Approved</RadzenText>
                </RadzenCard>
            </RadzenColumn>

            <RadzenColumn>
                <RadzenCard Variant="Variant.Outlined" class="py-1 ps-3 pe-5">
                    <RadzenText TextStyle="TextStyle.Overline">Not Approved</RadzenText>
                    <RadzenText TextStyle="TextStyle.H5">@TotalTransfer.NotApproved</RadzenText>
                </RadzenCard>
            </RadzenColumn>
        </RadzenRow>
    }
</RadzenCard>

<br />

<RadzenCard>
    <RadzenStack Orientation="Orientation.Horizontal">
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center">
            <RadzenLabel>Filter Agents</RadzenLabel>
            <RadzenDropDown @bind-Value="AgentFilterValue" Data="@(new List<string> { "All", "Online", "Offline"})" Change="GetAgents" />
        </RadzenStack>
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center">
            <RadzenLabel>Search Agents</RadzenLabel>
            <RadzenTextBox @oninput="args => SearchAgent(args?.Value?.ToString())" Placeholder="Search agent..." />
        </RadzenStack>
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center">
            <RadzenLabel>View As</RadzenLabel>
            <RadzenRadioButtonList @bind-Value="viewAs" >
                <Items>
                    <RadzenRadioButtonListItem Text="Card" Value="@("card")" />
                    <RadzenRadioButtonListItem Text="Table" Value="@("table")" />
                </Items>
            </RadzenRadioButtonList>
        </RadzenStack>
    </RadzenStack>
</RadzenCard>

<br />





<div class="row">

    @if (TotalAgents is null)
    {
        <em>Loading...</em>
    }
    else
    {
        if (SearchAgents is not null)
        {
            if (viewAs == "card")
            {
                <AgentDataInCard Agents="SearchAgents" />
            }
            if (viewAs == "table")
            {
                <RadzenCard>
                    <AgentDataInTable Agents="SearchAgents" />
                </RadzenCard>
            }
        }
        else
        {
            if (viewAs == "card")
            {
                <AgentDataInCard Agents="TotalAgents" />
            }
            if (viewAs == "table")
            {
                <RadzenCard>
                    <AgentDataInTable Agents="TotalAgents" />
                </RadzenCard>
            }
        }
    }

</div>







