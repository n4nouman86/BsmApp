@page "/AppUserEdit/{Id}"
@attribute [Authorize(Roles = "Super Admin")]
<PageTitle>Edit App User</PageTitle>

@inject UserManager<ApplicationUser> userManager
@inject RoleManager<IdentityRole> roleManager
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject NotificationService notify

<PageHeading HeadingText="Edit App User" />

<ErrorMessage Message="@ErrorMessage" />

<RadzenRow>
    <RadzenColumn SizeMD="6">
        <RadzenCard>
            @if (AppUser is null)
            {
                <em>Loading...</em>
            }
            else
            {
                <RadzenFieldset Text="App User Info">
                    <EditForm Model="InputUser" OnValidSubmit="UpdateAppUser">
                        <DataAnnotationsValidator />

                        <RadzenStack>
                            <RadzenStack Gap="0">
                                <RadzenLabel>Full Name</RadzenLabel>
                                <RadzenTextBox @bind-Value="InputUser.FullName" />
                                <ValidationMessage For="() => InputUser.FullName" class="rz-messages-error" />
                            </RadzenStack>

                            <RadzenStack Gap="0">
                                <RadzenLabel>Select Time Zone</RadzenLabel>
                                <RadzenDropDown @bind-Value="InputUser.TimeZoneInfoId"
                                                Data="TimeZones"
                                                ValueProperty="Id"
                                                TextProperty="Text"
                                                Change="GetSqlDateTime"
                                                AllowFiltering
                                                AllowVirtualization
                                                FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                                                class="w-100" />

                                <ValidationMessage For="() => InputUser.TimeZoneInfoId" class="rz-messages-error" />
                            </RadzenStack>

                            @if (InputUser.SqlDateTime.HasValue)
                            {
                                <RadzenStack>
                                    <RadzenText TextStyle="TextStyle.Subtitle2">
                                        @InputUser.TimeZoneInfoId : @InputUser.SqlDateTime.Value.ToDateTimeString()
                                    </RadzenText>
                                </RadzenStack>
                            }

                            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center">
                                <RadzenCheckBox @bind-Value="InputUser.CheckCheckForWhitelistIps" />
                                <RadzenLabel>Check for Whitelist IPs</RadzenLabel>
                            </RadzenStack>

                            <div>
                                <RadzenButton ButtonType="ButtonType.Submit">Update</RadzenButton>
                            </div>
                        </RadzenStack>
                    </EditForm>
                </RadzenFieldset>
            }
        </RadzenCard>
    </RadzenColumn>

    <RadzenColumn SizeMD="6">
        <RadzenCard>
            @if (Roles is null)
            {
                <em>Loading...</em>
            }
            else
            {
                <RadzenFieldset Text="Update Roles">
                    <RadzenStack>
                        @foreach (var item in Roles)
                        {
                            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center">
                                <RadzenCheckBox @bind-Value="item.IsChecked" />
                                <RadzenLabel>@item.RoleName</RadzenLabel>
                            </RadzenStack>
                        }

                        <div>
                            <RadzenButton Click="UpdateRoles">Update</RadzenButton>
                        </div>
                    </RadzenStack>
                </RadzenFieldset>
            }
        </RadzenCard>
    </RadzenColumn>
</RadzenRow>

<br />

<RadzenRow>
    <RadzenColumn SizeMD="6">
        <RadzenCard>
            @if (AppUser is null)
            {
                <em>Loading...</em>
            }
            else
            {
                <EditForm Model="InputPassword" OnValidSubmit="UpdatePassword" FormName="UpdatePassword">
                    <RadzenFieldset Text="New Password">
                        <DataAnnotationsValidator />
                        <RadzenStack>
                            <RadzenStack Gap="0">
                                <RadzenLabel>Password</RadzenLabel>
                                <RadzenTextBox @bind-Value="InputPassword.Password" />
                                <ValidationMessage For="() => InputPassword.Password" class="rz-messages-error" />
                            </RadzenStack>

                            <RadzenStack Gap="0">
                                <RadzenLabel>Confirm Password</RadzenLabel>
                                <RadzenTextBox @bind-Value="InputPassword.ConfirmPassword" />
                                <ValidationMessage For="() => InputPassword.ConfirmPassword" class="rz-messages-error" />
                            </RadzenStack>

                            <div>
                                <RadzenButton ButtonType="ButtonType.Submit">Update</RadzenButton>
                            </div>
                        </RadzenStack>
                    </RadzenFieldset>
                </EditForm>
            }
        </RadzenCard>
    </RadzenColumn>

    <RadzenColumn SizeMD="6">
        <RadzenCard>
            @if (AppUser is null)
            {
                <em>Loading...</em>
            }
            else
            {
                <RadzenFieldset Text="Account Status">
                    <RadzenStack>
                        @if (AppUser.LockoutEnd is null || AppUser.LockoutEnd < DateTime.Now)
                        {
                            <div>
                                <RadzenText>User account is <RadzenBadge BadgeStyle="BadgeStyle.Success">active</RadzenBadge>.</RadzenText>
                            </div>

                            <div>
                                <RadzenButton Click="LockedAccount">Lock</RadzenButton>
                            </div>
                        }
                        else
                        {
                            <div>
                                <RadzenText>User account is <RadzenBadge BadgeStyle="BadgeStyle.Danger">locked</RadzenBadge>.</RadzenText>
                            </div>

                            <div>
                                <RadzenButton ButtonStyle="ButtonStyle.Danger" Click="UnlockedAccount">Unlock</RadzenButton>
                            </div>
                        }
                    </RadzenStack>
                </RadzenFieldset>
            }
        </RadzenCard>
    </RadzenColumn>
</RadzenRow>





