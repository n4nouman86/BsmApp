@page "/CalledLeadIndex"
@attribute [Authorize(Roles = "Super Admin")]
<PageTitle>Called Leads</PageTitle>

@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject DialogService dialogService

<PageHeading HeadingText="Called Leads" />

<RadzenStack Orientation="Orientation.Horizontal">
    <RadzenCard>
        <RadzenFieldset Text="Search Info">
            <EditForm Model="Input" OnValidSubmit="SearchByPhone">
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.End">
                    <RadzenStack Gap="0">
                        <RadzenLabel>Search Phone</RadzenLabel>
                        <RadzenTextBox @bind-Value="Input.PhoneNumber" Placeholder="Enter phone" />
                    </RadzenStack>
                    <RadzenStack Gap="0">
                        <RadzenButton ButtonType="ButtonType.Submit" Text="Search" />
                    </RadzenStack>
                </RadzenStack>
            </EditForm>
        </RadzenFieldset>
    </RadzenCard>
</RadzenStack>

<br />

<RadzenCard>
    @if (CalledLeads is null)
    {
        <em>Loading...</em>
    }
    else
    {
        <RadzenDataGrid Data="@CalledLeads" EmptyText="No called leads to display">
            <Columns>
                <RadzenDataGridColumn Property="CalledOn" Title="Called On" FormatString="{0:MMM dd, yyyy hh:mm tt}" Width="220px" />
                <RadzenDataGridColumn Property="PhoneNumber" Title="Phone" Width="160px" />
                <RadzenDataGridColumn Property="FullName" Title="Full Name" />
                <RadzenDataGridColumn Property="HomeOwner" Title="Home Owner" Width="150px" />
                <RadzenDataGridColumn Property="State" Title="State" Width="120px" />
                <RadzenDataGridColumn Property="Status" Title="Status" Width="140px" />

                <RadzenDataGridColumn Title="Action" TextAlign="TextAlign.Center" Width="110px">
                    <Template Context="lead">
                        <RadzenButton Icon="edit" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Secondary"
                                      Click="@(() => OpenEdit(lead.Id))" title="Edit" />
                    </Template>
                </RadzenDataGridColumn>
            </Columns>
        </RadzenDataGrid>
    }
</RadzenCard>
