@page "/DashboardAgent"
@attribute [Authorize(Roles = "Agent")]
<PageTitle>Dashboard</PageTitle>

@inject IDbContextFactory<ApplicationDbContext> contextFactory
@inject AuthenticationStateProvider authProvider
@inject UserManager<ApplicationUser> userManager

<PageHeading HeadingText="Dashboard" />



<RadzenCard>
    @if (ChartData is null)
    {
        <em>Loading...</em>
    }
    else
    {
        <RadzenText TextStyle="TextStyle.Subtitle1" Text="Transfer summary by day" />
        <RadzenChart>
            <RadzenColumnSeries Data="ChartData" CategoryProperty="ChartLabel" ValueProperty="ChartVal" Title="Transfer" />
        </RadzenChart>
    }
</RadzenCard>



