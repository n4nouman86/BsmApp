@inject IDbContextFactory<ApplicationDbContext> contextFactory
@inject DialogService DialogService

<EditForm Model="Input" OnValidSubmit="Save">
    <DataAnnotationsValidator />
    <ValidationSummary class="text-danger" />

    <RadzenStack Gap="1rem">

        <RadzenFieldset Text="Contact Info">
            <RadzenStack Gap="0.5rem">
                <RadzenRow AlignItems="AlignItems.Center">
                    <RadzenColumn Size="4"><RadzenLabel Text="Phone" /></RadzenColumn>
                    <RadzenColumn Size="8">
                        <RadzenTextBox @bind-Value="Input.Phone" class="w-100" />
                        <ValidationMessage For="() => Input.Phone" class="text-danger" />
                    </RadzenColumn>
                </RadzenRow>
                <RadzenRow AlignItems="AlignItems.Center">
                    <RadzenColumn Size="4"><RadzenLabel Text="First Name (optional)" /></RadzenColumn>
                    <RadzenColumn Size="8">
                        <RadzenTextBox @bind-Value="Input.FirstName" class="w-100" />
                    </RadzenColumn>
                </RadzenRow>
                <RadzenRow AlignItems="AlignItems.Center">
                    <RadzenColumn Size="4"><RadzenLabel Text="Last Name (optional)" /></RadzenColumn>
                    <RadzenColumn Size="8">
                        <RadzenTextBox @bind-Value="Input.LastName" class="w-100" />
                    </RadzenColumn>
                </RadzenRow>
                <RadzenRow AlignItems="AlignItems.Center">
                    <RadzenColumn Size="4"><RadzenLabel Text="Email (optional)" /></RadzenColumn>
                    <RadzenColumn Size="8">
                        <RadzenTextBox @bind-Value="Input.Email" class="w-100" />
                    </RadzenColumn>
                </RadzenRow>
            </RadzenStack>
        </RadzenFieldset>

        <RadzenFieldset Text="Address">
            <RadzenStack Gap="0.5rem">
                <RadzenRow AlignItems="AlignItems.Center">
                    <RadzenColumn Size="4"><RadzenLabel Text="Address (optional)" /></RadzenColumn>
                    <RadzenColumn Size="8">
                        <RadzenTextBox @bind-Value="Input.Address1" class="w-100" />
                    </RadzenColumn>
                </RadzenRow>
                <RadzenRow AlignItems="AlignItems.Center">
                    <RadzenColumn Size="4"><RadzenLabel Text="City (optional)" /></RadzenColumn>
                    <RadzenColumn Size="8">
                        <RadzenTextBox @bind-Value="Input.City" class="w-100" />
                    </RadzenColumn>
                </RadzenRow>
                <RadzenRow AlignItems="AlignItems.Center">
                    <RadzenColumn Size="4"><RadzenLabel Text="State (optional)" /></RadzenColumn>
                    <RadzenColumn Size="8">
                        <RadzenTextBox @bind-Value="Input.State" class="w-100" />
                    </RadzenColumn>
                </RadzenRow>
                <RadzenRow AlignItems="AlignItems.Center">
                    <RadzenColumn Size="4"><RadzenLabel Text="Postal Code (optional)" /></RadzenColumn>
                    <RadzenColumn Size="8">
                        <RadzenTextBox @bind-Value="Input.PostalCode" class="w-100" />
                    </RadzenColumn>
                </RadzenRow>
            </RadzenStack>
        </RadzenFieldset>

        <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem">
            <RadzenButton ButtonType="ButtonType.Submit" Text="Save" ButtonStyle="ButtonStyle.Primary" />
            <RadzenButton ButtonType="ButtonType.Button" Text="Cancel" ButtonStyle="ButtonStyle.Light" Click="Cancel" />
        </RadzenStack>

    </RadzenStack>
</EditForm>
