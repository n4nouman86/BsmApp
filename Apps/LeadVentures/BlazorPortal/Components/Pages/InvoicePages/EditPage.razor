@inject IDbContextFactory<ApplicationDbContext> contextFactory
@inject DialogService DialogService
@inject NotificationService notify

@if (Input is null)
{
    <em>Loading...</em>
}
else
{
    <EditForm Model="Input" OnValidSubmit="Save">
        <DataAnnotationsValidator />
        <ValidationSummary class="text-danger" />

        <RadzenStack Gap="1rem">

            <RadzenFieldset Text="Basic Information">
                <RadzenStack Gap="0.5rem">
                    <RadzenRow AlignItems="AlignItems.Center">
                        <RadzenColumn Size="4"><RadzenLabel Text="Select Agent" /></RadzenColumn>
                        <RadzenColumn Size="8">
                            <RadzenDropDown @bind-Value="Input.AgentId" class="w-100" Data="Agents" ValueProperty="Id" TextProperty="Text"
                                AllowFiltering FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive" />
                            <ValidationMessage For="() => Input.AgentId" class="text-danger" />
                        </RadzenColumn>
                    </RadzenRow>
                    <RadzenRow AlignItems="AlignItems.Center">
                        <RadzenColumn Size="4"><RadzenLabel Text="Project Description" /></RadzenColumn>
                        <RadzenColumn Size="8">
                            <RadzenTextBox @bind-Value="Input.ProjectDescription" class="w-100" />
                            <ValidationMessage For="() => Input.ProjectDescription" class="text-danger" />
                        </RadzenColumn>
                    </RadzenRow>
                </RadzenStack>
            </RadzenFieldset>

            <RadzenFieldset Text="Dates">
                <RadzenStack Gap="0.5rem">
                    <RadzenRow AlignItems="AlignItems.Center">
                        <RadzenColumn Size="4"><RadzenLabel Text="Due Date" /></RadzenColumn>
                        <RadzenColumn Size="8"><RadzenDatePicker @bind-Value="Input.DueDate" class="w-100" DateFormat="dd MMM yyyy" /></RadzenColumn>
                    </RadzenRow>
                    <RadzenRow AlignItems="AlignItems.Center">
                        <RadzenColumn Size="4"><RadzenLabel Text="Service From" /></RadzenColumn>
                        <RadzenColumn Size="8"><RadzenDatePicker @bind-Value="Input.ServiceFrom" class="w-100" DateFormat="dd MMM yyyy" /></RadzenColumn>
                    </RadzenRow>
                    <RadzenRow AlignItems="AlignItems.Center">
                        <RadzenColumn Size="4"><RadzenLabel Text="Service To" /></RadzenColumn>
                        <RadzenColumn Size="8"><RadzenDatePicker @bind-Value="Input.ServiceTo" class="w-100" DateFormat="dd MMM yyyy" /></RadzenColumn>
                    </RadzenRow>
                </RadzenStack>
            </RadzenFieldset>

            <RadzenFieldset Text="Billing Details">
                <RadzenStack Gap="0.5rem">
                    <RadzenRow AlignItems="AlignItems.Center">
                        <RadzenColumn Size="4"><RadzenLabel Text="Billable Leads" /></RadzenColumn>
                        <RadzenColumn Size="8">
                            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                                <RadzenNumeric @bind-Value="Input.BillableLeads" class="w-100" />
                                <RadzenButton Text="Load" Click="LoadBillableLeads" />
                            </RadzenStack>
                        </RadzenColumn>
                    </RadzenRow>
                    <RadzenRow AlignItems="AlignItems.Center">
                        <RadzenColumn Size="4"><RadzenLabel Text="Cost Per Lead" /></RadzenColumn>
                        <RadzenColumn Size="8"><RadzenNumeric @bind-Value="Input.CostPerLead" class="w-100" /></RadzenColumn>
                    </RadzenRow>
                    <RadzenRow AlignItems="AlignItems.Center">
                        <RadzenColumn Size="4"><RadzenLabel Text="Discount Amount" /></RadzenColumn>
                        <RadzenColumn Size="8"><RadzenNumeric @bind-Value="Input.DiscountAmount" class="w-100" /></RadzenColumn>
                    </RadzenRow>
                    <RadzenRow AlignItems="AlignItems.Center">
                        <RadzenColumn Size="4"><RadzenLabel Text="Total Cost" /></RadzenColumn>
                        <RadzenColumn Size="8"><RadzenNumeric @bind-Value="Input.CalculateTotalCost" class="w-100" Disabled /></RadzenColumn>
                    </RadzenRow>
                </RadzenStack>
            </RadzenFieldset>

            <RadzenFieldset Text="Payment & Notes (optional)">
                <RadzenStack Gap="0.5rem">
                    <RadzenRow AlignItems="AlignItems.Center">
                        <RadzenColumn Size="4"><RadzenLabel Text="Invoice From" /></RadzenColumn>
                        <RadzenColumn Size="8">
                            <RadzenDropDown @bind-Value="Input.InvoiceFromId" class="w-100" Data="InvoiceFroms"
                                ValueProperty="Id" TextProperty="InvoiceBy" AllowFiltering AllowClear />
                        </RadzenColumn>
                    </RadzenRow>
                    <RadzenRow AlignItems="AlignItems.Center">
                        <RadzenColumn Size="4"><RadzenLabel Text="Banks" /></RadzenColumn>
                        <RadzenColumn Size="8">
                            <RadzenDropDown @bind-Value="BankIds" class="w-100" Data="Banks"
                                ValueProperty="Id" TextProperty="Text" Multiple AllowFiltering AllowClear />
                        </RadzenColumn>
                    </RadzenRow>
                    <RadzenRow AlignItems="AlignItems.Center">
                        <RadzenColumn Size="4"><RadzenLabel Text="Paid On" /></RadzenColumn>
                        <RadzenColumn Size="8"><RadzenDatePicker @bind-Value="Input.PaidOn" class="w-100" DateFormat="dd MMM yyyy" AllowClear /></RadzenColumn>
                    </RadzenRow>
                    <RadzenRow AlignItems="AlignItems.Center">
                        <RadzenColumn Size="4"><RadzenLabel Text="Receive Amount" /></RadzenColumn>
                        <RadzenColumn Size="8"><RadzenNumeric @bind-Value="Input.ReceiveAmount" class="w-100" /></RadzenColumn>
                    </RadzenRow>
                    <RadzenRow AlignItems="AlignItems.Start">
                        <RadzenColumn Size="4" class="pt-1"><RadzenLabel Text="Memo" /></RadzenColumn>
                        <RadzenColumn Size="8"><RadzenTextArea @bind-Value="Input.Memo" Rows="3" class="w-100" /></RadzenColumn>
                    </RadzenRow>
                </RadzenStack>
            </RadzenFieldset>

            <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem">
                <RadzenButton ButtonType="ButtonType.Submit" Text="Save" ButtonStyle="ButtonStyle.Primary" />
                <RadzenButton ButtonType="ButtonType.Button" Text="Cancel" ButtonStyle="ButtonStyle.Light" Click="Cancel" />
            </RadzenStack>

        </RadzenStack>
    </EditForm>
}
