@page "/InvoiceDefault"
@attribute [Authorize(Roles = "Super Admin")]
<PageTitle>Default Invoices</PageTitle>

@inject IDbContextFactory<ApplicationDbContext> contextFactory
@inject DialogService dialogService

<PageHeading HeadingText="Default Invoices" />



<RadzenCard>
    <RadzenStack Orientation="Orientation.Horizontal">
        <RadzenBadge BadgeStyle="BadgeStyle.Danger" class="fs-6 p-2">Total Default Amount: @Invoices?.Sum(x => x.TotalCost).ToString("C0")</RadzenBadge>
    </RadzenStack>
</RadzenCard>

<br />




<RadzenCard>
    @if (Invoices is null)
    {
        <em>Loading...</em>
    }
    else
    {
        <RadzenDataGrid Data="Invoices">

            <Columns>
                <RadzenDataGridColumn Property="InvoiceNo" Title="Invoice No">
                    <Template Context="invoice">
                        @string.Concat("AC", invoice.InvoiceNo)
                    </Template>
                </RadzenDataGridColumn>

                <RadzenDataGridColumn Property="CreateOn" Title="Invoice Date" FormatString="{0:dd MMM yyyy}" />
                <RadzenDataGridColumn Property="FullName" Title="Agent Name" />
                <RadzenDataGridColumn Property="ProjectDescription" Title="Project Description" />

                <RadzenDataGridColumn Title="Due Date" TextAlign="TextAlign.Center">
                    <Template Context="invoice">
                        @invoice.DueDate.ToDateString()
                    </Template>
                </RadzenDataGridColumn>

                <RadzenDataGridColumn Title="Service From" TextAlign="TextAlign.Center">
                    <Template Context="invoice">
                        @invoice.ServiceFrom.ToDateString()
                    </Template>
                </RadzenDataGridColumn>

                <RadzenDataGridColumn Title="Service To" TextAlign="TextAlign.Center">
                    <Template Context="invoice">
                        @invoice.ServiceTo.ToDateString()
                    </Template>
                </RadzenDataGridColumn>

                <RadzenDataGridColumn Property="BillableLeads" Title="Billable Leads" FormatString="{0:N0}" TextAlign="TextAlign.Center" />
                <RadzenDataGridColumn Property="CostPerLead" Title="Cost Per Lead" FormatString="{0:C}" TextAlign="TextAlign.Center" />
                <RadzenDataGridColumn Property="TotalCost" Title="Total Cost" FormatString="{0:C}" TextAlign="TextAlign.Center" />

                <RadzenDataGridColumn Title="Paid On">
                    <Template Context="invoice">
                        @if (invoice.PaidOn.HasValue)
                        {
                            <RadzenBadge BadgeStyle="BadgeStyle.Success">@invoice.PaidOn?.ToDateString()</RadzenBadge>
                        }
                        else
                        {
                            <RadzenBadge BadgeStyle="BadgeStyle.Danger">not paid</RadzenBadge>
                        }
                    </Template>
                </RadzenDataGridColumn>

                <RadzenDataGridColumn Title="Action" TextAlign="TextAlign.Center">
                    <Template Context="invoice">

                        <RadzenButton Icon="check_box" Size="ButtonSize.Small" ButtonStyle="@ButtonStyle.Success" Click="@(() => SaveDefault(invoice))" />

                        <RadzenLink Path="@String.Concat("InvoiceView/", invoice.Id)" Target="blank">
                            <RadzenButton Icon="print" Size="ButtonSize.Small" ButtonStyle="@ButtonStyle.Info" />
                        </RadzenLink>

                    </Template>
                </RadzenDataGridColumn>
            </Columns>

        </RadzenDataGrid>
    }
</RadzenCard>