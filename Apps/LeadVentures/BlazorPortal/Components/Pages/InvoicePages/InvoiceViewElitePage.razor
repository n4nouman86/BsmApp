@layout BlazorPortal.Components.Layout.InvoiceLayout

@page "/InvoiceViewElite/{Id:guid}"
@attribute [Authorize(Roles = "Super Admin")]
<PageTitle>Invoices</PageTitle>

@inject IDbContextFactory<ApplicationDbContext> contextFactory
@inject IJSRuntime JSRuntime


<style>
    h1:focus {
        outline: none;
    }

    td, th {
        padding: 3px !important;
    }

    .cus-txt-s1 {
        font-size: 11px;
    }

    h1, h2, h6, th, b {
        color: #424141 !important;
    }

    .socal-icon-size {
        font-size: 40px;
        padding: 0px 10px 0px 10px;
    }
</style>


<div class="container-fluid">
    <header>
        <div class="d-flex justify-content-between">
            <div class="d-flex">
                <img src="/logo/singlelogo.png" height="60" class="mt-3" />

                <div class="ps-2">
                    <h2 class="text-uppercase p-0 m-0 " style="margin-top:18px !important;">Elite Techlogix</h2>
                    <p class="p-0 m-0 text-uppercase" style="font-size:10px; margin-top:-3px !important;">INFORMATION TECHNOLOGY SERVICES</p>
                </div>
            </div>
            <div class="d-flex align-items-end">
                <p class="m-0 p-0">
                    <b>Invoice Date:</b> @Invoice.CreateOn.ToString("dd MMM yyyy")
                </p>
            </div>
        </div>
    </header>

    <hr />
    <br />

    <content class="d-flex justify-content-between">
        <div>
            <div>
                <h6 class="text-uppercase">Contact Info</h6>
            </div>
            <div class="cus-txt-s1">
                <p>
                    @InvoiceFrom.InvoiceBy

                    <br />

                    @if (!string.IsNullOrWhiteSpace(InvoiceFrom.Address))
                    {
                        @InvoiceFrom.Address
                        <br />
                        <br />
                    }

                    @if (!string.IsNullOrWhiteSpace(InvoiceFrom.MobileNumber))
                    {
                        @InvoiceFrom.MobileNumber
                        <br />
                    }

                    @if (!string.IsNullOrWhiteSpace(InvoiceFrom.LandLineNumber))
                    {
                        @InvoiceFrom.LandLineNumber
                        <br />
                    }

                    @InvoiceFrom.EmailAddress

                </p>
            </div>
        </div>
        <div class="text-right" style="width:350px">
            <div>
                <h1 class="text-uppercase">Invoice</h1>
            </div>
            <table class="table cus-txt-s1" style="border-color:white !important;">
                <tbody>
                    <tr>
                        <th>TO:</th>
                        <td class="text-end">@Agent.FullName (@Agent.AgentEmail)</td>
                    </tr>
                    <tr>
                        <th width="80">INVOICE NO:</th>
                        <td class="text-end">@string.Concat("AC", Invoice.InvoiceNo)</td>
                    </tr>
                    <tr>
                        <th>DUE DATE:</th>
                        <td class="text-end">@Invoice.DueDate.ToString("dd MMM yyyy")</td>
                    </tr>
                    <tr>
                        <th width="80">SERVICE:</th>
                        <td class="text-end">@Invoice.ServiceFrom.ToString("dd MMM yyyy") to @Invoice.ServiceTo.ToString("dd MMM yyyy")</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </content>

    <br />

    <content>
        <div class="">
            <table class="table table-condensed cus-txt-s1" style="border-color: #424141 !important; ">
                <thead>
                    <tr>
                        <th>Project Description</th>
                        <th class="text-center" width="100">Billed Unit/Hour</th>
                        <th class="text-center" width="100">Cost Per Unit/Hour</th>
                        <th class="text-center" width="100">Amount</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>Digital Marketing & IT Services</td>
                        <td class="text-center">@Invoice.BillableLeads</td>
                        <td class="text-center">@Invoice.CostPerLead.ToString("C2")</td>
                        <td class="text-center">@((Invoice.BillableLeads * Invoice.CostPerLead).ToString("C2"))</td>
                    </tr>
                </tbody>
                <tfoot>
                    @if (Invoice.DiscountAmount.HasValue && Invoice.DiscountAmount.Value > 0)
                    {
                        <tr>
                            <th class="text-end" colspan="3">Discount</th>
                            <th class="text-center">@Invoice.DiscountAmount?.ToString("C2")</th>
                        </tr>
                    }
                    <tr>
                        <th class="text-end" colspan="3">Total</th>
                        <th class="text-center">@Invoice.CalculateTotalCost.ToString("C2")</th>
                    </tr>
                </tfoot>
            </table>
        </div>
    </content>

    <content>
        <p class="m-0 small fw-semibold mb-2">The invoiced amount does not include Payoneer service charges.</p>
    </content>


    <content class="cus-txt-s1">
        <div class="mb-3">
            <b class="text-uppercase"><u>Information regarding payment options</u></b>
        </div>        

        @foreach (var InvoiceBank in InvoiceBanks)
        {
            <table class="table table-bordered">
                <tr>
                    <th class="align-top" width="100">Option @Counter</th>
                    <td>
                        <div>
                            <p>
                                <b>Currency: </b> @InvoiceBank.Currency
                                <br />

                                @if (InvoiceBank.InvoiceBankTypeId == 1)
                                {

                                    <b>Bank Name: </b> @InvoiceBank.BankName
                                    <br />
                                    <b>Bank Address: </b> @InvoiceBank.BankAddress
                                    <br />
                                    <b>Routing (ABA): </b> @InvoiceBank.Routing
                                    <br />
                                    <b>Account Number: </b> @InvoiceBank.AccountNumber
                                    <br />
                                    <b>Account Type: </b> @InvoiceBank.AccountType
                                    <br />
                                    <b>Beneficiary Name: </b> @InvoiceBank.BeneficiaryName
                                }

                                @if (InvoiceBank.InvoiceBankTypeId == 2)
                                {
                                    <b>Bank Name: </b> @InvoiceBank.BankName
                                    <br />
                                    <b>Branch Address: </b> @InvoiceBank.BranchAddress
                                    <br />
                                    <b>Account Title: </b> @InvoiceBank.AccountTitle
                                    <br />
                                    <b>IBAN/Account Number: </b> @InvoiceBank.IbanorAccountNumber
                                    <br />
                                    <b>Swift Code: </b> @InvoiceBank.SwiftCode
                                }

                                @if (InvoiceBank.InvoiceBankTypeId == 3)
                                {
                                    <b>Payment Platform:</b>
                                    <span>Upwork</span>
                                    <br />
                                    <b>Contract Name: </b> @InvoiceBank.ContractName
                                }

                                @if (InvoiceBank.InvoiceBankTypeId == 4)
                                {
                                    <b>Payment Platform: </b>

                                    <span> Payoneer</span>
                                    <br />
                                    <b>Beneficiary Name: </b> <span> @InvoiceBank.BeneficiaryName</span>
                                    <br />
                                    <b>Payoneer Email: </b> <span> @InvoiceBank.Email</span>
                                }


                                @if (InvoiceBank.InvoiceBankTypeId == 5)
                                {
                                    <b>Payment Platform: </b>

                                    <span> Credit Card (Upwork Direct Payment Link for Credit Card)</span>
                                    <br />
                                    <b>Contact Name: </b> <span> @InvoiceBank.ContactName</span>
                                    <br />
                                    <b>Payment Link: </b> <span> @InvoiceBank.PaymentLink</span>
                                }




                                @if (InvoiceBank.InvoiceBankTypeId == 6)
                                {
                                    <b>Bank Name: </b> @InvoiceBank.BankName
                                    <br />
                                    <b>Bank Address: </b> @InvoiceBank.BankAddress
                                    <br />
                                    <b>Bank Code: </b> @InvoiceBank.BankCode
                                    <br />
                                    <b>Branch Code: </b> @InvoiceBank.BranchCode
                                    <br />
                                    <b>Swift Code: </b> @InvoiceBank.SwiftCode
                                    <br />
                                    <b>IBAN/Account Number: </b> @InvoiceBank.IbanorAccountNumber
                                    <br />
                                    <b>Beneficiary Name: </b> @InvoiceBank.BeneficiaryName
                                }
                            </p>
                            
                        </div>

                        <div>
                            @if (!string.IsNullOrWhiteSpace(InvoiceBank.Guidlines))
                            {
                                var guidlines = InvoiceBank.Guidlines.Split(';').ToList();

                                <b class="text-uppercase"><u>Terms & Conditions</u></b>

                                <ul class="text-danger">
                                    @foreach (var item in guidlines)
                                    {
                                        <li>
                                            <strong>@item</strong>
                                        </li>
                                    }
                                </ul>
                            }
                        </div>
                    </td>
                </tr>
            </table>
            Counter++;
        }
    </content>
</div>

<script>
    function PrintInvoice(){
        window.print()
    }
</script>



