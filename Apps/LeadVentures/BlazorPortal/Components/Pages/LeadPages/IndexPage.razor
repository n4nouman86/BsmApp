@page "/LeadIndex"
@attribute [Authorize(Roles = "Super Admin")]
<PageTitle>Leads</PageTitle>

@inject IDbContextFactory<ApplicationDbContext> DbFactory

<PageHeading HeadingText="Leads" />

<RadzenStack Orientation="Orientation.Horizontal">
    <RadzenCard>
        <RadzenFieldset Text="Search Info">
            <EditForm Model="Input" OnValidSubmit="SearchLeads" FormName="Search">
                <RadzenStack Orientation="Orientation.Horizontal">
                    <RadzenStack Gap="0">
                        <RadzenLabel>From Date</RadzenLabel>
                        <RadzenDatePicker @bind-Value="Input.FromDate" DateFormat="dd MMM yyyy" />
                    </RadzenStack>
                    <RadzenStack Gap="0">
                        <RadzenLabel>To Date</RadzenLabel>
                        <RadzenDatePicker @bind-Value="Input.ToDate" DateFormat="dd MMM yyyy" />
                    </RadzenStack>
                    <RadzenStack Gap="0">
                        <RadzenLabel>Agent (optional)</RadzenLabel>
                        <RadzenDropDown @bind-Value="Input.AgentId" Data="Agents" ValueProperty="Id" TextProperty="Text" AllowClear AllowFiltering FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive" />
                    </RadzenStack>
                    <RadzenStack Gap="0">
                        <RadzenLabel>Disposition (optional)</RadzenLabel>
                        <RadzenDropDown @bind-Value="Input.DispositionId" Data="Dispositions" ValueProperty="Id" TextProperty="Name" AllowClear />
                    </RadzenStack>
                    <RadzenStack JustifyContent="JustifyContent.End">
                        <RadzenButton ButtonType="ButtonType.Submit" Text="Search" />
                    </RadzenStack>
                </RadzenStack>
            </EditForm>
        </RadzenFieldset>
    </RadzenCard>

    <RadzenCard>
        <RadzenFieldset Text="Search Info">
            <EditForm Model="InputPhone" OnValidSubmit="SearchPhone" FormName="SearchPhone">
                <RadzenStack Orientation="Orientation.Horizontal">
                    <RadzenStack Gap="0">
                        <RadzenLabel>Search Phone</RadzenLabel>
                        <RadzenTextBox @bind-Value="InputPhone.PhoneNumber" class="" />
                    </RadzenStack>

                    <RadzenStack JustifyContent="JustifyContent.End">
                        <RadzenButton ButtonType="ButtonType.Submit" Text="Search" />
                    </RadzenStack>
                </RadzenStack>
            </EditForm>
        </RadzenFieldset>
    </RadzenCard>
</RadzenStack>

<br />

<RadzenCard>
    @if (Leads is null)
    {
        <em>Loading...</em>
    }
    else
    {
        <RadzenDataGrid Data="Leads" AllowVirtualization="true" AllowPaging PageSize="10" >
            <Columns>
                <RadzenDataGridColumn Title="Transfer On" Width="180px" >
                    <Template Context="lead">
                        @lead.TransferOn.DateTime.ToString("MMM dd, yyyy hh':'mm tt")
                    </Template>
                    <FooterTemplate>
                        Total: <b>@Leads.Count().ToString("N0")</b>
                    </FooterTemplate>
                </RadzenDataGridColumn>

                <RadzenDataGridColumn Property="AgentFullName" Title="Agent Name" />
                <RadzenDataGridColumn Property="FullName" Title="Lead Name" />
                <RadzenDataGridColumn Property="PhoneNumber" Title="Phone" />
                <RadzenDataGridColumn Property="State" Title="State" TextAlign="TextAlign.Center" />

                <RadzenDataGridColumn Title="Dispostion On" Width="180px">
                    <Template Context="lead">
                        @lead.DispositionOn?.DateTime.ToString("MMM dd, yyyy hh':'mm tt")
                    </Template>
                </RadzenDataGridColumn>

                <RadzenDataGridColumn Property="DispositionTypeName" Title="Disposition Type" TextAlign="TextAlign.Center">
                    <FooterTemplate>
                        Total: <b>@Leads.Where(x => x.DispositionTypeId != null).Count().ToString("N0")</b>
                    </FooterTemplate>
                </RadzenDataGridColumn>
                
                <RadzenDataGridColumn Property="DispositionStatusName" Title="Disposition Status" TextAlign="TextAlign.Center" />  
                
                <RadzenDataGridColumn Title="Is Billable" TextAlign="TextAlign.Center">
                    <Template Context="lead">
                        <BooleanBadge BoolValue="lead.IsBillable" GreenText="yes" DangerText="no" />
                    </Template>
                    <FooterTemplate>
                        Total: <b>@Leads.Where(x => x.IsBillable == true).Count().ToString("N0")</b>
                    </FooterTemplate>
                </RadzenDataGridColumn>

                <RadzenDataGridColumn Title="Action" TextAlign="TextAlign.Center">
                    <Template Context="lead">
                        <RadzenLink Path="@String.Concat("LeadEdit/", lead.Id)">
                            <RadzenButton Icon="edit" Size="ButtonSize.Small" ButtonStyle="@ButtonStyle.Secondary" />
                        </RadzenLink>

                        <RadzenLink Path="@String.Concat("LeadStatus/", lead.Id)">
                            <RadzenButton Icon="highlight_keyboard_focus" Size="ButtonSize.Small" ButtonStyle="@ButtonStyle.Secondary" />
                        </RadzenLink>
                    </Template>
                </RadzenDataGridColumn>
            </Columns>
        </RadzenDataGrid>
    }
</RadzenCard>


