@page "/PaymentRequestCreate"
@attribute [Authorize(Roles = "Super Admin")]
<PageTitle>Create Payment Request</PageTitle>

@inject IDbContextFactory<ApplicationDbContext> contextFactory
@inject NotificationService notificationService
@inject PaymentRequestEmailService emailService
@inject NavigationManager navigationManager

<PageHeading HeadingText="Create Payment Request" />

<RadzenRow>
    <RadzenColumn SizeMD="4">
        <RadzenCard>
            <EditForm Model="Input" OnValidSubmit="CreateExInvoice">
                <DataAnnotationsValidator />

                <RadzenStack>
                    <RadzenStack Gap="0">
                        <RadzenLabel>Request From</RadzenLabel>
                        <RadzenDropDown @bind-Value="Input.FromId" Data="Froms" TextProperty="FromName" ValueProperty="Id" />
                        <ValidationMessage For="@(() => Input.FromId)" />
                    </RadzenStack>

                    <RadzenStack Gap="0">
                        <RadzenLabel>Due Date</RadzenLabel>
                        <RadzenDatePicker @bind-Value="Input.DueDate" DateFormat="dd MMMM yyyy" />
                        <ValidationMessage For="@(() => Input.DueDate)" />
                    </RadzenStack>

                    <RadzenStack Gap="0">
                        <RadzenLabel>Client Name</RadzenLabel>
                        <RadzenTextBox @bind-Value="Input.ClientName" />
                        <ValidationMessage For="@(() => Input.ClientName)" />
                    </RadzenStack>

                    <RadzenStack Gap="0">
                        <RadzenLabel>Client Email</RadzenLabel>
                        <RadzenTextBox @bind-Value="Input.ClientEmail" />
                        <ValidationMessage For="@(() => Input.ClientEmail)" />
                    </RadzenStack>

                    <RadzenStack Gap="0">
                        <RadzenLabel>Amount</RadzenLabel>
                        <RadzenNumeric @bind-Value="Input.Amount" />
                        <ValidationMessage For="@(() => Input.Amount)" />
                    </RadzenStack>

                    <RadzenStack Gap="0">
                        <RadzenLabel>Description</RadzenLabel>
                        <RadzenTextArea @bind-Value="Input.Description" />
                        <ValidationMessage For="@(() => Input.Description)" />
                    </RadzenStack>

                    <div>
                        <RadzenButton Text="Create" ButtonType="ButtonType.Submit" Disabled="disableCreateButton" />
                    </div>
                </RadzenStack>
            </EditForm>
        </RadzenCard>
    </RadzenColumn>
</RadzenRow>
