@inject IDbContextFactory<ApplicationDbContext> contextFactory
@inject DialogService DialogService

<EditForm Model="Input" OnValidSubmit="Save">
    <DataAnnotationsValidator />
    <ValidationSummary class="text-danger" />

    <div class="mb-3">
        <RadzenLabel>Transfer Time</RadzenLabel>
        <RadzenDatePicker @bind-Value="Input.TransferTime" ShowTime="true" class="w-100" />
    </div>

    <div class="mb-3">
        <RadzenLabel>KG Best Day</RadzenLabel>
        <RadzenNumeric @bind-Value="Input.KgBestDay" class="w-100" />
    </div>

    <div class="mb-3">
        <RadzenLabel>KG Transfers</RadzenLabel>
        <RadzenNumeric @bind-Value="Input.KgTransfers" class="w-100" />
    </div>

    <div class="mb-3">
        <RadzenLabel>BSM Best Day</RadzenLabel>
        <RadzenNumeric @bind-Value="Input.BsmBestDay" class="w-100" />
    </div>

    <div class="mb-3">
        <RadzenLabel>BSM Transfers</RadzenLabel>
        <RadzenNumeric @bind-Value="Input.BsmTransfers" class="w-100" />
    </div>

    <div class="d-flex gap-2 mt-3">
        <RadzenButton ButtonType="ButtonType.Submit" Text="Save" ButtonStyle="ButtonStyle.Primary" />
        <RadzenButton ButtonType="ButtonType.Button" Text="Cancel" ButtonStyle="ButtonStyle.Light" Click="Cancel" />
    </div>

</EditForm>
