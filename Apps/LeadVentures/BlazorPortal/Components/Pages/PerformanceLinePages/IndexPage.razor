@page "/PerformanceLines/{PerformanceId:int}"
@attribute [Authorize(Roles = "Super Admin")]
<PageTitle>Performance Lines</PageTitle>

@inject IDbContextFactory<ApplicationDbContext> contextFactory
@inject DialogService dialogService
@inject NavigationManager navManager

<PageHeading HeadingText="@($"Performance Lines — {PerformanceDate:MMM dd, yyyy}")" />

<div class="mb-3 d-flex gap-2">
    <RadzenButton Icon="add" Text="Add New" ButtonStyle="ButtonStyle.Primary" Click="OpenCreate" />
    <RadzenButton Icon="arrow_back" Text="Back" ButtonStyle="ButtonStyle.Light" Click="@(() => navManager.NavigateTo("PerformanceIndex"))" />
</div>

<RadzenCard>
    @if (Lines is null)
    {
        <em>Loading...</em>
    }
    else
    {

        <RadzenDataGrid Data="@Lines">
            <Columns>
                <RadzenDataGridColumn Property="TransferTime" Title="Transfer Time" FormatString="{0:MMM dd, hh':'mm tt}" />
                <RadzenDataGridColumn Property="KgBestDay" Title="KG Best Day" TextAlign="TextAlign.Center" />
                <RadzenDataGridColumn Property="KgTransfers" Title="KG Transfers" TextAlign="TextAlign.Center" />
                <RadzenDataGridColumn Property="BsmBestDay" Title="BSM Best Day" TextAlign="TextAlign.Center" />
                <RadzenDataGridColumn Property="BsmTransfers" Title="BSM Transfers" TextAlign="TextAlign.Center" />

                <RadzenDataGridColumn Title="Action" TextAlign="TextAlign.Center" Width="120px">
                    <Template Context="model">
                        <RadzenButton Icon="edit" Size="ButtonSize.ExtraSmall" ButtonStyle="ButtonStyle.Secondary"
                            Click="@(() => OpenEdit(model))" />
                        <RadzenButton Icon="delete" Size="ButtonSize.ExtraSmall" ButtonStyle="ButtonStyle.Danger"
                            class="ms-1" Click="@(() => ConfirmDelete(model.Id))" />
                    </Template>
                </RadzenDataGridColumn>
            </Columns>
        </RadzenDataGrid>
    }
</RadzenCard>
