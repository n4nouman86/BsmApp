@page "/QALeadIndex"
@attribute [Authorize(Roles = "QA")]
<PageTitle>QA Leads</PageTitle>

@inject IDbContextFactory<ApplicationDbContext> contextFactory

<PageHeading HeadingText="QA Leads" />

<RadzenCard>
    <RadzenFieldset Text="Search Info">
        <EditForm Model="Input" OnValidSubmit="SearchLeads">
            <DataAnnotationsValidator />

            <RadzenStack Orientation="Orientation.Horizontal">
                <div>
                    <RadzenLabel>From</RadzenLabel>
                    <RadzenDatePicker @bind-Value="Input.FromDate" DateFormat="dd-MMM-yyyy" />
                    <ValidationMessage For="() => Input.FromDate" class="text-danger" />
                </div>
                <div>
                    <RadzenLabel>To</RadzenLabel>
                    <RadzenDatePicker @bind-Value="Input.ToDate" DateFormat="dd-MMM-yyyy" />
                    <ValidationMessage For="() => Input.ToDate" class="text-danger" />
                </div>
                <div>
                    <RadzenButton ButtonType="ButtonType.Submit" Text="Search" />
                </div>
            </RadzenStack>

        </EditForm>
    </RadzenFieldset>
</RadzenCard>

<br />

<RadzenCard>

    @if (Leads is null)
    {
        <em>Loading...</em>
    }
    else
    {
        <RadzenDataGrid Data="Leads">

            <Columns>
                <RadzenDataGridColumn Title="Transfer On" Width="180px" >
                    <Template Context="lead">
                        @lead.TransferOn.ToServerDateTimeOffset().DateTime.ToDateTimeString()
                    </Template>
                </RadzenDataGridColumn>

                <RadzenDataGridColumn Property="AgentFullName" Title="Agent Name" />
                <RadzenDataGridColumn Property="PhoneNumber" Title="Phone Number" TextAlign="TextAlign.Center" />
                <RadzenDataGridColumn Property="State" Title="State" TextAlign="TextAlign.Center" />

                <RadzenDataGridColumn Title="Disposition On" Width="180px">
                    <Template Context="lead">
                        @lead.DispositionOn?.ToServerDateTimeOffset().DateTime.ToDateTimeString()
                    </Template>
                </RadzenDataGridColumn>

                <RadzenDataGridColumn Property="DispositionTypeName" Title="Disposition Type" TextAlign="TextAlign.Center" />
                <RadzenDataGridColumn Property="DispositionStatusName" Title="Disposition Status" TextAlign="TextAlign.Center" />

                <RadzenDataGridColumn Title="Is Billable" TextAlign="TextAlign.Center">
                    <Template Context="lead">
                        <BooleanBadge BoolValue="lead.IsBillable" GreenText="yes" DangerText="no" />
                    </Template>
                </RadzenDataGridColumn>

                <RadzenDataGridColumn Title="Action" TextAlign="TextAlign.Center">
                    <Template Context="lead">
                        <RadzenLink Path="@String.Concat("QALeadEdit/", lead.Id)">
                            <RadzenButton Icon="edit" Size="ButtonSize.Small" ButtonStyle="@ButtonStyle.Secondary" />
                        </RadzenLink>

                        <RadzenLink Path="@String.Concat("LeadStatus/", lead.Id)">
                            <RadzenButton Icon="highlight_keyboard_focus" Size="ButtonSize.Small" ButtonStyle="@ButtonStyle.Secondary" />
                        </RadzenLink>
                    </Template>
                </RadzenDataGridColumn>
            </Columns>

        </RadzenDataGrid>
    }
</RadzenCard>