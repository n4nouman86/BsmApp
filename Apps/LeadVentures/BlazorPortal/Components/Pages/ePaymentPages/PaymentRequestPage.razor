@page "/PaymentRequest/{Id:guid}"
@layout EPaymentLayout
<PageTitle>Payment Request</PageTitle>

@inject IDbContextFactory<ApplicationDbContext> contextFactory
@inject MastercardService mastercardService
@inject NavigationManager navigationManager
@inject IJSRuntime jsRuntime

<PageHeading HeadingText="Payment Request" />

@if (!string.IsNullOrWhiteSpace(ErrorMessage))
{
    <RadzenAlert AlertStyle="AlertStyle.Danger">
        @ErrorMessage
    </RadzenAlert>
}

@if (Invoice is null)
{
    <RadzenSkeleton />
}
else
{
    <RadzenCard>
        <RadzenTable>
            <RadzenTableRow>
                <RadzenTableCell width="200"><strong>Requested By:</strong></RadzenTableCell>
                <RadzenTableCell>@From?.FromName</RadzenTableCell>
            </RadzenTableRow>
            <RadzenTableRow>
                <RadzenTableCell><strong>Due Date:</strong></RadzenTableCell>
                <RadzenTableCell>@Invoice.DueDate.ToString("dd MMM yyyy")</RadzenTableCell>
            </RadzenTableRow>
            <RadzenTableRow>
                <RadzenTableCell><strong>Client Name:</strong></RadzenTableCell>
                <RadzenTableCell>@Invoice.ClientName</RadzenTableCell>
            </RadzenTableRow>
            <RadzenTableRow>
                <RadzenTableCell><strong>Client Email:</strong></RadzenTableCell>
                <RadzenTableCell>@Invoice.ClientEmail</RadzenTableCell>
            </RadzenTableRow>
            <RadzenTableRow>
                <RadzenTableCell><strong>Amount:</strong></RadzenTableCell>
                <RadzenTableCell>@Invoice.Amount.ToString("C2")</RadzenTableCell>
            </RadzenTableRow>
            <RadzenTableRow>
                <RadzenTableCell><strong>Description:</strong></RadzenTableCell>
                <RadzenTableCell>@Invoice.Description</RadzenTableCell>
            </RadzenTableRow>
            <RadzenTableRow>
                <RadzenTableCell><strong>Paid On:</strong></RadzenTableCell>
                <RadzenTableCell>@Invoice.PaidOn?.ToString("dd MMM yyyy")</RadzenTableCell>
            </RadzenTableRow>
            <RadzenTableRow>
                <RadzenTableCell><strong>Payment Status:</strong></RadzenTableCell>
                <RadzenTableCell>@Invoice.PaymentStatus</RadzenTableCell>
            </RadzenTableRow>
        </RadzenTable>

        <br />

        <RadzenButton Click="ProceedToPayment">
            Proceed to Payment
        </RadzenButton>
    </RadzenCard>
}



<script src="https://mcbpk.gateway.mastercard.com/static/checkout/checkout.min.js" 
        data-error="errorCallback" 
        data-cancel="cancelCallback"></script>

<script>
    function startCheckout(sessionId) {
        Checkout.configure({
            session: {
                id: sessionId
            }
        });

        Checkout.showPaymentPage()
    }

    function errorCallback(error) {
        console.log(JSON.stringify(error));
    }

    function cancelCallback() {
        console.log('Payment cancelled');
    }

</script>

