@page "/PaymentRequestResponse/{Id:guid}"
@layout EPaymentLayout
<PageTitle>Payment Request</PageTitle>

@inject IDbContextFactory<ApplicationDbContext> contextFactory
@inject MastercardService mastercardService
@inject IJSRuntime js

<RadzenText TextAlign="TextAlign.Center" TextStyle="TextStyle.H4">
    Payment Request Details
</RadzenText>

<br />

@if (!string.IsNullOrWhiteSpace(SuccessMessage))
{
    <RadzenStack AlignItems="AlignItems.Center" Gap="0">
        <RadzenIcon Icon="check_circle" Style="color: green; font-size: 50px;" />
        <RadzenText TextStyle="TextStyle.H5" Style="color: green;">
            @SuccessMessage
        </RadzenText>
    </RadzenStack>
    
    <br />
}


@if (!string.IsNullOrWhiteSpace(ErrorMessage))
{
    <RadzenAlert AlertStyle="AlertStyle.Danger">
        @ErrorMessage
    </RadzenAlert>
}

@if (Request is null)
{
    <RadzenSkeleton />
}
else
{
    <RadzenCard>
        <RadzenTable>
            <RadzenTableRow>
                <RadzenTableCell width="200"><strong>Requested By:</strong></RadzenTableCell>
                <RadzenTableCell>@From?.FromName</RadzenTableCell>
            </RadzenTableRow>
            <RadzenTableRow>
                <RadzenTableCell><strong>Due Date:</strong></RadzenTableCell>
                <RadzenTableCell>@Request.DueDate.ToString("dd MMM yyyy")</RadzenTableCell>
            </RadzenTableRow>
            <RadzenTableRow>
                <RadzenTableCell><strong>Client Name:</strong></RadzenTableCell>
                <RadzenTableCell>@Request.ClientName</RadzenTableCell>
            </RadzenTableRow>
            <RadzenTableRow>
                <RadzenTableCell><strong>Client Email:</strong></RadzenTableCell>
                <RadzenTableCell>@Request.ClientEmail</RadzenTableCell>
            </RadzenTableRow>
            <RadzenTableRow>
                <RadzenTableCell><strong>Amount:</strong></RadzenTableCell>
                <RadzenTableCell>@Request.Amount.ToString("C2")</RadzenTableCell>
            </RadzenTableRow>
            <RadzenTableRow>
                <RadzenTableCell><strong>Description:</strong></RadzenTableCell>
                <RadzenTableCell>@Request.Description</RadzenTableCell>
            </RadzenTableRow>
            <RadzenTableRow>
                <RadzenTableCell><strong>Paid On:</strong></RadzenTableCell>
                <RadzenTableCell>@Request.PaidOn?.ToString("dd MMM yyyy")</RadzenTableCell>
            </RadzenTableRow>
            <RadzenTableRow>
                <RadzenTableCell><strong>Payment Status:</strong></RadzenTableCell>
                <RadzenTableCell>@Request.PaymentStatus</RadzenTableCell>
            </RadzenTableRow>
            <RadzenTableRow>
                <RadzenTableCell width="200"><strong>Order Id:</strong></RadzenTableCell>
                <RadzenTableCell>@Request.Id</RadzenTableCell>
            </RadzenTableRow>
        </RadzenTable>

        <br />

        <RadzenButton Click="Print">
            Print
        </RadzenButton>
    </RadzenCard>
}




