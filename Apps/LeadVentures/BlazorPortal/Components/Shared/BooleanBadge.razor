
@if (BoolValue)
{
    <RadzenBadge BadgeStyle="BadgeStyle.Success">@GreenText</RadzenBadge>
}
else
{
    <RadzenBadge BadgeStyle="BadgeStyle.Danger">@DangerText</RadzenBadge>
}

@code {
    [Parameter]
    public bool BoolValue { get; set; }
    [Parameter]
    public string GreenText { get; set; } = "";
    [Parameter]
    public string DangerText { get; set; } = "";
}
